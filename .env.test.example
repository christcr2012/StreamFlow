# E2E Test Environment Configuration
# Copy this file to .env.test and fill in the values

# Test User Credentials - Tenant App
TEST_OWNER_EMAIL=owner@test.com
TEST_OWNER_PASSWORD=password123
TEST_MANAGER_EMAIL=manager@test.com
TEST_MANAGER_PASSWORD=password123
TEST_TECH_EMAIL=tech@test.com
TEST_TECH_PASSWORD=password123

# Test User Credentials - Provider Portal
TEST_PROVIDER_EMAIL=provider@test.com
TEST_PROVIDER_PASSWORD=password123

# Application URLs
TENANT_APP_URL=http://localhost:3000
PROVIDER_PORTAL_URL=http://localhost:3001

# Base URL for tests (defaults to TENANT_APP_URL)
BASE_URL=http://localhost:3000

# Database (for test data setup)
DATABASE_URL=postgresql://user:password@localhost:5432/cortiware_test

# Optional: Vercel deployment URLs for testing against deployed environments
# TENANT_APP_URL=https://tenant-app-staging.vercel.app
# PROVIDER_PORTAL_URL=https://provider-portal-staging.vercel.app

