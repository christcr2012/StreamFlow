  clientOrgId    String
  leadId         String
  conversionType String
  amountCents    Int
  metadataJson   Json
  createdAt      DateTime @default(now())
  status         String   @default("received") // received|accepted|failed
}

/// IdempotencyKey ensures idempotent POST requests in federation API
model IdempotencyKey {
  key       String   @id
  method    String
  path      String
  bodyHash  String
  response  Json
  orgId     String
  createdAt DateTime @default(now())
  ttl       Int
}

// ============================================================================
// DEVELOPER PORTAL - API KEY MANAGEMENT
// ============================================================================

/// DeveloperAPIKey stores app-scoped API keys for developer authentication
/// Used for secure API access with granular permissions
model DeveloperAPIKey {
  id          String    @id @default(cuid())
  name        String    // Human-readable name for the key
  keyId       String    @unique // Public key identifier (e.g., "dev_abc123")
  secretHash  String    // Hashed secret for verification
  userId      String    // Developer user ID
  orgId       String?   // Optional organization scope
  scopes      String[]  @default([]) // Permission scopes
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
}

// ============================================================================
// SECRETS ROTATION AUTOMATION
// ============================================================================

/// SecretsRotationPolicy defines automated key rotation rules
model SecretsRotationPolicy {
  id                   String    @id @default(cuid())
  orgId                String    // Organization identifier
  name                 String    // Policy name
  keyType              String    // 'federation' | 'api' | 'encryption'
  rotationIntervalDays Int       // Days between rotations
  gracePeriodDays      Int       // Days old keys remain valid
  autoRotate           Boolean   @default(false) // Auto-rotate on schedule
  notifyBeforeDays     Int       // Days before rotation to notify
  enabled              Boolean   @default(true)
  lastRotation         DateTime? // Last rotation timestamp
  nextRotation         DateTime? // Next scheduled rotation
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([orgId, keyType])
  @@index([nextRotation, enabled])
}

/// SecretsRotationHistory tracks all key rotations
model SecretsRotationHistory {
  id         String   @id @default(cuid())
  orgId      String   // Organization identifier
  policyId   String?  // Associated policy (null for manual rotations)
  keyType    String   // 'federation' | 'api' | 'encryption'
  oldKeyId   String   // Previous key identifier
  newKeyId   String   // New key identifier
  rotatedAt  DateTime @default(now())
  rotatedBy  String   // Email of user who triggered rotation
  reason     String   // 'scheduled' | 'manual' | 'compromised' | 'policy'
  metadata   Json?    // Additional rotation details

  @@index([orgId, rotatedAt])
  @@index([keyType, rotatedAt])
}

// ============================================================================
// CUSTOM FIELDS SYSTEM
// ============================================================================

/// CustomFieldDefinition defines custom fields that can be added to entities
model CustomFieldDefinition {
  id          String   @id @default(cuid())
  orgId       String   // Organization identifier
  entityType  String   // 'lead' | 'customer' | 'job' | 'invoice'
  fieldName   String   // Internal field name (slug)
  displayName String   // User-facing label
  fieldType   String   // 'text' | 'number' | 'date' | 'boolean' | 'select' | 'multiselect'
  options     Json?    // For select/multiselect: array of options
  required    Boolean  @default(false)
  defaultValue String?
  validation  Json?    // Validation rules (min, max, pattern, etc.)
  order       Int      @default(0) // Display order
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values CustomFieldValue[]

  @@unique([orgId, entityType, fieldName])
  @@index([orgId, entityType, enabled])
}

/// CustomFieldValue stores actual custom field values for entities
model CustomFieldValue {
  id          String   @id @default(cuid())
  fieldId     String
  field       CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  entityType  String   // 'lead' | 'customer' | 'job' | 'invoice'
  entityId    String   // ID of the entity (lead, customer, etc.)
  value       String   // Stored as string, parsed based on fieldType
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([fieldId, entityId])
  @@index([entityType, entityId])
}

/// ============================================================================
/// COMPLIANCE & SECURITY TRACKING
/// ============================================================================

/// ComplianceFramework tracks compliance status for various frameworks
model ComplianceFramework {
  id                String   @id @default(cuid())
  framework         String   // 'SOC2' | 'HIPAA' | 'GDPR' | 'PCI-DSS'
  status            String   // 'compliant' | 'partial' | 'non-compliant'
  lastAuditDate     DateTime?
  nextAuditDate     DateTime?
  certificationUrl  String?  // URL to certification document
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  audits            ComplianceAudit[]
  findings          ComplianceFinding[]

  @@unique([framework])
  @@index([status])
}

/// ComplianceAudit tracks individual compliance audits
model ComplianceAudit {
  id                String   @id @default(cuid())
  frameworkId       String
  framework         ComplianceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  auditDate         DateTime
  auditor           String   // Name of auditing firm/person
  result            String   // 'pass' | 'pass_with_findings' | 'fail'
  reportUrl         String?  // URL to audit report
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  findings          ComplianceFinding[]

  @@index([frameworkId, auditDate])
}

/// ComplianceFinding tracks individual findings from audits
model ComplianceFinding {
  id                String   @id @default(cuid())
  frameworkId       String
  framework         ComplianceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  auditId           String?
  audit             ComplianceAudit? @relation(fields: [auditId], references: [id], onDelete: SetNull)
  severity          String   // 'critical' | 'high' | 'medium' | 'low'
  title             String
  description       String   @db.Text
  remediation       String?  @db.Text
  status            String   // 'open' | 'in_progress' | 'resolved' | 'accepted_risk'
  dueDate           DateTime?
  resolvedDate      DateTime?
  assignedTo        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([frameworkId, status])
  @@index([severity, status])
}

/// DataRetentionPolicy defines data retention rules
model DataRetentionPolicy {
  id                String   @id @default(cuid())
  dataType          String   // 'audit_logs' | 'customer_data' | 'payment_records' | etc
  retentionDays     Int      // Number of days to retain data
  autoDelete        Boolean  @default(false)
  lastReviewDate    DateTime?
  nextReviewDate    DateTime?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([dataType])
  @@index([autoDelete])
}

/// EncryptionConfig tracks encryption status for various components
model EncryptionConfig {
  id                String   @id @default(cuid())
  component         String   // 'database' | 'api_keys' | 'backups' | 'file_storage' | etc
  encrypted         Boolean  @default(true)
  algorithm         String   // 'AES-256-GCM' | 'RSA-2048' | etc
  keyRotationDate   DateTime?
  nextRotationDate  DateTime?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([component])
  @@index([encrypted])
}

/// VulnerabilityScan tracks security vulnerability scans
model VulnerabilityScan {
  id                String   @id @default(cuid())
  scanDate          DateTime
  scanner           String   // 'Snyk' | 'Dependabot' | 'Manual' | etc
  totalVulns        Int      @default(0)
  criticalVulns     Int      @default(0)
  highVulns         Int      @default(0)
  mediumVulns       Int      @default(0)
  lowVulns          Int      @default(0)
  resolvedVulns     Int      @default(0)
  reportUrl         String?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([scanDate])
}

// ============================================
// DEVELOPER PORTAL MODELS
// ============================================

/// Webhook endpoints for event notifications
model WebhookEndpoint {
  id          String   @id @default(cuid())
  name        String
  url         String
  events      String[] // Array of event types to subscribe to
  secret      String   // HMAC secret for signature verification
  active      Boolean  @default(true)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  WebhookDelivery[]

  @@index([active])
  @@index([createdAt])
}

/// Webhook delivery logs and retry tracking
model WebhookDelivery {
  id            String   @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  status        String   // 'pending' | 'success' | 'failed' | 'retrying'
  statusCode    Int?
  responseBody  String?  @db.Text
  errorMessage  String?  @db.Text
  attempts      Int      @default(0)
  maxAttempts   Int      @default(3)
  nextRetryAt   DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([endpointId, createdAt])
  @@index([status, nextRetryAt])
  @@index([event, createdAt])
}

/// Developer API keys for authentication
model DeveloperApiKey {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  keyHash     String   @unique
  keyPrefix   String   // First 8 chars for identification (e.g., "dev_1234")
  scopes      String[] // Array of permitted scopes
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([keyPrefix])
  @@index([expiresAt])
  @@index([createdAt])
}

/// API usage metrics for developer dashboards
model ApiUsageMetric {
  id          String   @id @default(cuid())
  endpoint    String
  method      String   // 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE'
  statusCode  Int
  latency     Int      // Response time in milliseconds
  apiKeyId    String?  // Reference to DeveloperApiKey if authenticated
  userAgent   String?
  ipAddress   String?
  timestamp   DateTime @default(now())

  @@index([endpoint, timestamp])
  @@index([apiKeyId, timestamp])
  @@index([statusCode, timestamp])
  @@index([timestamp])
}

/// AI Developer Assistant conversation history
model AiAssistantConversation {
  id          String   @id @default(cuid())
  sessionId   String
  role        String   // 'user' | 'assistant' | 'system'
  content     String   @db.Text
  metadata    Json?    // Code snippets, API references, etc.
  createdAt   DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
}



// ============================================================================
// MARKETING PRICING MANAGEMENT
// ============================================================================
// These models manage the pricing displayed on the marketing website.
// Pricing can be edited from the Provider Portal and automatically updates
// the marketing site via ISR (Incremental Static Regeneration).

/// MarketingPricingPlan stores the pricing tiers displayed on www.cortiware.com
/// Each plan represents a subscription tier (Starter, Professional, Enterprise)
model MarketingPricingPlan {
  id          String   @id @default(cuid())
  name        String   // "Starter", "Professional", "Enterprise"
  slug        String   @unique // "starter", "professional", "enterprise"
  price       Int?     // Price in cents (null for "Contact Sales")
  currency    String   @default("USD") // ISO currency code
  description String   // Short description of the plan
  cta         String   // Call-to-action text: "Start Free Trial", "Contact Sales"
  highlighted Boolean  @default(false) // Shows "MOST POPULAR" badge
  active      Boolean  @default(true) // Whether to display on marketing site
  sortOrder   Int      @default(0) // Display order (1, 2, 3...)

  // Approval Workflow
  status      MarketingPricingStatus @default(DRAFT) // DRAFT, PENDING_REVIEW, PUBLISHED
  publishedAt DateTime? // When it was last published

  features    MarketingPricingFeature[]
  history     MarketingPricingHistory[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String? // User ID who created this plan
  updatedBy   String? // User ID who last updated this plan

  @@index([active, sortOrder])
  @@index([status])
  @@map("marketing_pricing_plans")
}

/// MarketingPricingFeature stores individual features for each pricing plan
model MarketingPricingFeature {
  id          String   @id @default(cuid())
  planId      String
  plan        MarketingPricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  text        String   // "Up to 3 users", "Advanced AI automation"
  sortOrder   Int      @default(0) // Display order within the plan

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([planId, sortOrder])
  @@map("marketing_pricing_features")
}

/// MarketingPricingHistory tracks all pricing changes for audit purposes
model MarketingPricingHistory {
  id          String   @id @default(cuid())
  planId      String
  plan        MarketingPricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // Snapshot of what changed
  action      String   // "CREATED", "UPDATED", "PUBLISHED", "UNPUBLISHED"
  changes     Json     // JSON object with before/after values

  // Who made the change
  changedBy   String   // User ID
  changedByEmail String? // User email for reference
  reason      String?  // Optional reason for the change

  createdAt   DateTime @default(now())

  @@index([planId, createdAt])
  @@index([changedBy])
  @@map("marketing_pricing_history")
}

/// Enum for pricing plan approval workflow status
enum MarketingPricingStatus {
  DRAFT           // Being edited, not visible on marketing site
  PENDING_REVIEW  // Submitted for review
  PUBLISHED       // Live on marketing site
}
