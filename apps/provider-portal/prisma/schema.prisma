// ============================================================================
// PROVIDER OPERATIONS - ADD-ON PURCHASES
// ============================================================================

/// AddonPurchase tracks one-off purchases and refunds
/// Used for add-on revenue tracking and reconciliation
model AddonPurchase {
  id          String    @id @default(cuid())
  orgId       String
  sku         String    // SKU identifier (e.g., 'extra_storage_100gb', 'priority_support')
  amount      Decimal   @db.Decimal(12, 2)
  status      String    // 'purchased' | 'refunded'
  purchasedAt DateTime  @default(now())
  refundedAt  DateTime?
  meta        Json      @default("{}")

