// ============================================================================
// PROVIDER OPERATIONS - FEDERATION KEY MANAGEMENT
// ============================================================================

/// FederationKey stores HMAC keys for provider-side federation
/// Used for secure machine-to-machine authentication
model FederationKey {
  id         String    @id @default(cuid())
  keyId      String    @unique // Public key identifier
  secretHash String    // Hashed secret for HMAC verification
  orgId      String    // Organization identifier
  createdAt  DateTime  @default(now())
  disabledAt DateTime? // When key was disabled (soft delete)

  @@index([orgId, keyId])
}

/// OIDCConfig stores OIDC/OAuth provider configuration for federation
model OIDCConfig {
  id            String    @id @default(cuid())
  enabled       Boolean   @default(false)
  issuerUrl     String    // OIDC issuer URL
  clientId      String    // OAuth client ID
  clientSecret  String    // Encrypted OAuth client secret
  scopes        String    @default("openid profile email") // Space-separated scopes
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastTestedAt  DateTime? // Last successful connection test
}

/// ProviderIntegration tracks external provider connections
model ProviderIntegration {
  id          String    @id @default(cuid())
  name        String    // Provider name (e.g., "Acme Corp")
  type        String    // 'oidc' | 'saml' | 'api_key'
  config      Json      @default("{}") // Provider-specific configuration
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastSyncAt  DateTime? // Last successful sync

  @@index([type, enabled])
}

/// AuditEvent stores provider-side audit trail
model AuditEvent {
  id          String   @id @default(cuid())
  actorType   String   // 'provider' | 'system' | 'ai_dev'
  actorId     String?  // Provider user ID or system identifier
  orgId       String?  // Organization identifier
  action      String   // 'create' | 'update' | 'delete' | 'access'
  entityType  String   // 'federation_key' | 'oidc_config' | 'client' | etc.
  entityId    String?  // ID of affected entity
  result      String   @default("success") // 'success' | 'failure'
  metadata    Json     @default("{}") // Additional context (redacted PII)
  redactJson  Json?    // Redacted sensitive fields
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([orgId, entityType, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

/// AnalyticsSnapshot stores daily aggregated metrics for caching
model AnalyticsSnapshot {
  id              String   @id @default(cuid())
  snapshotDate    DateTime @db.Date // Date of snapshot
  mrrCents        Int      @default(0) // Monthly Recurring Revenue in cents
  arrCents        Int      @default(0) // Annual Recurring Revenue in cents
  activeClients   Int      @default(0)
  newClients      Int      @default(0)
  churnedClients  Int      @default(0)
  totalRevenue    Int      @default(0) // Total revenue in cents
  metricsJson     Json     @default("{}") // Additional metrics
  createdAt       DateTime @default(now())

  @@unique([snapshotDate])
  @@index([snapshotDate])
}

// ============================================================================
// PROVIDER CONTROL CENTER - NEW MODELS (GPT-5)
// ============================================================================

/// Incident lifecycle tracking with SLA fields
model Incident {
  id                   String   @id @default(cuid())
  orgId                String
  severity             IncidentSeverity
  status               IncidentStatus    @default(OPEN)
  title                String
  description          String
  assigneeUserId       String?
  slaResponseDeadline  DateTime?
  slaResolveDeadline   DateTime?
  acknowledgedAt       DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  org Org @relation("OrgIncidents", fields: [orgId], references: [id])

  @@index([orgId, status, createdAt])
  @@index([orgId, severity])
}

/// InvoiceLine ties granular charges to Invoices
model InvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  description     String
  lineType        InvoiceLineType
  quantity        Int      @default(1)
  unitPriceCents  Int
  amountCents     Int
  sourceType      String?
  sourceId        String?
  createdAt       DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([sourceType, sourceId])
}

/// Provider in-app notifications
model Notification {
  id        String   @id @default(cuid())
  orgId     String?
  audience  String   // 'provider' | 'developer'
  type      String
  title     String
  body      String
  severity  String   // 'info' | 'warning' | 'error'
  readAt    DateTime?
  createdAt DateTime @default(now())

  org Org? @relation("OrgNotifications", fields: [orgId], references: [id])

  @@index([orgId, createdAt])
}

enum IncidentSeverity {
  P1
  P2
  P3
}

enum IncidentStatus {
  OPEN
  ACK
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum InvoiceLineType {
  subscription
  usage
  addon
  one_time
}


// ============================================================================
// MONETIZATION CORE (Plans, Prices, Offers, Coupons, Overrides, Global Config)
// ============================================================================

enum BillingCadence {
  MONTHLY
  YEARLY
}

enum OverrideType {
  FREE
  DISCOUNT
  CUSTOM_AMOUNT
}

model PricePlan {
  id          String      @id @default(cuid())
  key         String      @unique           // e.g. "starter", "pro", "enterprise"
  name        String
  description String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  prices      PlanPrice[]
  offers      Offer[]
  overrides   TenantPriceOverride[]
  asDefaultFor GlobalMonetizationConfig[]
  invites     OnboardingInvite[]
}

model PlanPrice {
  id              String         @id @default(cuid())
  planId          String
  currency        String         @default("usd")
  unitAmountCents Int            // 999 = $9.99
  cadence         BillingCadence @default(MONTHLY)
  trialDays       Int?           @default(0)
  active          Boolean        @default(true)
  stripePriceId   String?        // optional mapping
  createdAt       DateTime       @default(now())
  overrides   TenantPriceOverride[]
  asDefaultFor GlobalMonetizationConfig[]
  invites     OnboardingInvite[]

  updatedAt       DateTime       @updatedAt

  plan PricePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, active])
  @@index([stripePriceId])
}

model Offer {
  id              String      @id @default(cuid())
  name            String
  percentOff      Int?        // 1..100
  amountOffCents  Int?
  duration        String?     // 'once' | 'repeating' | 'forever'
  durationMonths  Int?
  appliesToPlanId String?
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  appliesToPlan PricePlan? @relation(fields: [appliesToPlanId], references: [id])
  invites       OnboardingInvite[]
}

model Coupon {
  id              String      @id @default(cuid())
  code            String      @unique
  name            String?
  percentOff      Int?
  amountOffCents  Int?
  duration        String?     // 'once' | 'repeating' | 'forever'
  durationMonths  Int?
  startsAt        DateTime?
  endsAt          DateTime?
  maxRedemptions  Int?
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  invites       OnboardingInvite[]
}

model TenantPriceOverride {
  id              String        @id @default(cuid())
  orgId           String
  planId          String?
  priceId         String?
  type            OverrideType  @default(DISCOUNT)
  percentOff      Int?
  amountOffCents  Int?
  priceCents      Int?
  startsAt        DateTime?
  endsAt          DateTime?
  reason          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  org   Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan  PricePlan? @relation(fields: [planId], references: [id])
  price PlanPrice? @relation(fields: [priceId], references: [id])

  @@index([orgId])
  @@index([planId])
  @@index([priceId])
}

model GlobalMonetizationConfig {
  id               String   @id @default(cuid())
  defaultPlanId    String?
  defaultPriceId   String?
  defaultTrialDays Int?     @default(0)
  publicOnboarding Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  defaultPlan  PricePlan? @relation(fields: [defaultPlanId], references: [id])
  defaultPrice PlanPrice? @relation(fields: [defaultPriceId], references: [id])
}

model OnboardingInvite {
  id         String   @id @default(cuid())
  token      String   @unique
  email      String?
  planId     String?
  priceId    String?
  offerId    String?
  couponId   String?
  trialDays  Int?     @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  note       String?
  createdAt  DateTime @default(now())

  plan   PricePlan? @relation(fields: [planId], references: [id])
  price  PlanPrice? @relation(fields: [priceId], references: [id])
  offer  Offer?     @relation(fields: [offerId], references: [id])
  coupon Coupon?    @relation(fields: [couponId], references: [id])

  @@index([expiresAt, usedAt])
}

// ============================================================================
// PROVIDER FEDERATION v3+ MODELS
// ============================================================================

/// FederatedClient tracks external client organizations using the federation API
model FederatedClient {
  id              String    @id @default(cuid())
  orgId           String    @unique
  name            String
  contactEmail    String
  planType        String
  apiKeyId        String    @unique
  webhookEndpoint String?
  lastSeen        DateTime?
  monthlyRevenue  Int       @default(0)
  convertedLeads  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// WebhookRegistration stores webhook endpoints for federated clients
model WebhookRegistration {
  id         String   @id @default(cuid())
  orgId      String   @unique
  url        String
  secretHash String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
}

/// EscalationTicket tracks escalations received via federation API
model EscalationTicket {
  id           String   @id @default(cuid())
  escalationId String   @unique
  tenantId     String
  orgId        String
  type         String
  severity     String
  description  String
  createdAt    DateTime @default(now())
  state        String   @default("received") // received|sandbox_created|pr_opened|canary_requested|rolled_out|rolled_back
}

/// FederationInvoice tracks billing events received via federation API
model FederationInvoice {
