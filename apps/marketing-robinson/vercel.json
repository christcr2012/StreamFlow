{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && npm run build -- --filter=marketing-robinson",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm install",
  "ignoreCommand": "npx turbo-ignore marketing-robinson",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "redirects": [
    {
      "source": "/provider/:path*",
      "destination": "https://provider.robinsonaisystems.com/provider/:path*",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/portal/:path*",
      "destination": "https://provider-portal.vercel.app/:path*"
    }
  ]
}

