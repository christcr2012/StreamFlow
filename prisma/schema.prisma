generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/@prisma/client-tenant"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id         String   @id @default(cuid())
  orgId      String
  actorType  String
  actorId    String?
  entityType String
  entityId   String
  action     String
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())
  Org        Org      @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId, createdAt])
}

model AddonPurchase {
  id          String    @id @default(cuid())
  orgId       String
  sku         String
  amount      Decimal   @db.Decimal(12, 2)
  status      String
  purchasedAt DateTime  @default(now())
  refundedAt  DateTime?
  meta        Json      @default("{}")
  Org         Org       @relation(fields: [orgId], references: [id])

  @@index([orgId, sku, status])
  @@index([purchasedAt])
}

model Agreement {
  id                String            @id @default(cuid())
  orgId             String
  customerId        String
  templateId        String
  status            String            @default("draft")
  content           String
  variables         Json              @default("{}")
  signUrl           String?
  signedAt          DateTime?
  signedBy          String?
  renewalAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  Customer          Customer          @relation(fields: [customerId], references: [id])
  AgreementTemplate AgreementTemplate @relation(fields: [templateId], references: [id])

  @@index([customerId])
  @@index([orgId, status, renewalAt])
}

model AgreementTemplate {
  id          String      @id @default(cuid())
  orgId       String?
  name        String
  verticalKey String?
  content     String
  mergeFields Json        @default("[]")
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  Agreement   Agreement[]

  @@index([orgId, isActive])
  @@index([verticalKey])
}

model AiModelTest {
  id                String              @id @default(cuid())
  orgId             String
  testName          String
  feature           String
  modelA            String
  modelB            String
  status            String              @default("active")
  trafficSplit      Int                 @default(50)
  startedAt         DateTime            @default(now())
  endedAt           DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Org               Org                 @relation(fields: [orgId], references: [id])
  AiModelTestResult AiModelTestResult[]

  @@index([orgId, feature])
  @@index([orgId, status])
}

model AiModelTestResult {
  id          String      @id @default(cuid())
  testId      String
  model       String
  feature     String
  tokensIn    Int
  tokensOut   Int
  costUsd     Decimal     @db.Decimal(8, 6)
  latencyMs   Int
  userRating  Int?
  success     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  AiModelTest AiModelTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId, createdAt])
  @@index([testId, model])
}

model AiMonthlySummary {
  id          String   @id @default(cuid())
  orgId       String
  monthKey    String
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  costUsd     Decimal  @default(0) @db.Decimal(8, 2)
  creditsUsed Int      @default(0)
  callCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Org         Org      @relation(fields: [orgId], references: [id])

  @@unique([orgId, monthKey])
  @@index([monthKey])
}

model AiUsageEvent {
  id          String   @id @default(cuid())
  orgId       String
  userId      String?
  feature     String
  model       String
  tokensIn    Int
  tokensOut   Int
  costUsd     Decimal  @db.Decimal(8, 6)
  creditsUsed Int
  requestId   String?
  createdAt   DateTime @default(now())
  Org         Org      @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, feature, createdAt])
  @@index([orgId, feature])
}

model AIUsageLog {
  id          String   @id @default(cuid())
  orgId       String
  userId      String?
  feature     String
  model       String
  tokensIn    Int
  tokensOut   Int
  costCents   Int // Cost in cents for easier aggregation
  costUsd     Decimal  @db.Decimal(8, 6)
  creditsUsed Int
  requestId   String?
  createdAt   DateTime @default(now())
  Org         Org      @relation("OrgAIUsageLogs", fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, feature, createdAt])
}

model SMSLog {
  id         String   @id @default(cuid())
  orgId      String
  userId     String?
  toNumber   String
  fromNumber String?
  message    String
  status     String // 'sent', 'delivered', 'failed'
  costCents  Int // Cost in cents
  provider   String   @default("twilio")
  sid        String? // Provider message ID
  createdAt  DateTime @default(now())
  Org        Org      @relation("OrgSMSLogs", fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, status, createdAt])
}

model CostAlert {
  id            String    @id @default(cuid())
  orgId         String
  alertType     String // 'AI_USAGE', 'SMS_USAGE', 'TOTAL_USAGE'
  threshold     Int // Threshold in cents
  period        String // 'DAILY', 'WEEKLY', 'MONTHLY'
  email         String
  webhookUrl    String?
  enabled       Boolean   @default(true)
  lastTriggered DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  Org           Org       @relation("OrgCostAlerts", fields: [orgId], references: [id])

  @@index([orgId, enabled])
  @@index([orgId, alertType, enabled])
}

model AnalyticsSnapshot {
  id             String   @id @default(cuid())
  snapshotDate   DateTime @unique @db.Date
  mrrCents       Int      @default(0)
  arrCents       Int      @default(0)
  activeClients  Int      @default(0)
  newClients     Int      @default(0)
  churnedClients Int      @default(0)
  totalRevenue   Int      @default(0)
  metricsJson    Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([snapshotDate])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  orgId       String
  entityId    String?
  createdAt   DateTime @default(now())
  actorUserId String?
  entity      String
  field       String?
  newValue    Json?
  oldValue    Json?
  reason      String?
  Org         Org      @relation(fields: [orgId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([orgId, createdAt])
  @@index([orgId, entity, createdAt])
}

model BillingLedger {
  id        String     @id @default(cuid())
  orgId     String
  type      LedgerType
  amount    Decimal    @db.Decimal(12, 2)
  meta      Json       @default("{}")
  createdAt DateTime   @default(now())
  Org       Org        @relation(fields: [orgId], references: [id])

  @@index([orgId, type])
}

model BreakglassActivationLog {
  id                String   @id @default(cuid())
  userId            String
  orgId             String
  reason            String
  method            String
  riskScore         Int
  riskFactors       String
  delayMinutes      Int
  verificationSteps String
  ipAddress         String
  userAgent         String
  success           Boolean
  errorMessage      String?
  notifiedAdmins    String
  timestamp         DateTime @default(now())

  @@index([orgId, timestamp])
  @@index([riskScore])
  @@index([userId, timestamp])
}

model CleaningChecklistTemplate {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  spaceType String
  itemsJson Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Org       Org      @relation(fields: [orgId], references: [id])

  @@index([orgId, spaceType])
}

model CleaningContract {
  id                 String              @id @default(cuid())
  orgId              String
  estimateId         String              @unique
  customerId         String?
  siteAddress        String
  spaceType          String
  squareFeet         Int
  recurrenceRule     String?
  frequency          String
  startDate          DateTime
  endDate            DateTime?
  basePrice          Decimal             @db.Decimal(12, 2)
  taxRate            Decimal?            @db.Decimal(5, 2)
  escalatorPct       Decimal?            @db.Decimal(5, 2)
  slaResponseHours   Int?
  slaCompletionHours Int?
  status             String              @default("ACTIVE")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  CleaningEstimate   CleaningEstimate    @relation(fields: [estimateId], references: [id])
  Org                Org                 @relation(fields: [orgId], references: [id])
  CleaningWorkOrder  CleaningWorkOrder[]

  @@index([orgId, startDate])
  @@index([orgId, status])
}

model CleaningEstimate {
  id               String            @id @default(cuid())
  orgId            String
  leadId           String?
  version          Int               @default(1)
  spaceType        String
  squareFeet       Int
  frequency        String
  optionsJson      Json
  status           String            @default("DRAFT")
  acceptedOption   String?
  signedAt         DateTime?
  signedBy         String?
  signatureUrl     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  CleaningContract CleaningContract?
  CleaningLead     CleaningLead?     @relation(fields: [leadId], references: [id])
  Org              Org               @relation(fields: [orgId], references: [id])

  @@index([leadId])
  @@index([orgId, status])
}

model CleaningInspection {
  id                String              @id @default(cuid())
  orgId             String
  workOrderId       String              @unique
  inspectorId       String?
  inspectedAt       DateTime?
  checklistJson     Json
  score             Decimal?            @db.Decimal(5, 2)
  defectsCount      Int                 @default(0)
  status            String              @default("PENDING")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Org               Org                 @relation(fields: [orgId], references: [id])
  CleaningWorkOrder CleaningWorkOrder[]

  @@index([orgId, inspectedAt])
  @@index([orgId, status])
}

model CleaningLead {
  id               String             @id @default(cuid())
  orgId            String
  company          String?
  contactName      String
  email            String?
  phone            String?
  address          String
  city             String
  state            String
  zip              String
  lat              Decimal?           @db.Decimal(10, 7)
  lon              Decimal?           @db.Decimal(10, 7)
  spaceType        String
  squareFeet       Int?
  frequency        String?
  status           String             @default("NEW")
  aiEstimateJson   Json?
  aiTokensUsed     Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  CleaningEstimate CleaningEstimate[]
  Org              Org                @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, status])
}

model CleaningWorkOrder {
  id                     String                   @id @default(cuid())
  orgId                  String
  contractId             String?
  publicId               String                   @unique
  siteAddress            String
  spaceType              String
  squareFeet             Int
  scheduledDate          DateTime
  scheduledStart         DateTime
  scheduledEnd           DateTime
  assignedTo             String?
  assignedAt             DateTime?
  actualStart            DateTime?
  actualEnd              DateTime?
  status                 String                   @default("SCHEDULED")
  checklistJson          Json?
  inspectionId           String?
  photosJson             Json?
  signatureUrl           String?
  signedBy               String?
  signedAt               DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  CleaningContract       CleaningContract?        @relation(fields: [contractId], references: [id])
  CleaningInspection     CleaningInspection?      @relation(fields: [inspectionId], references: [id])
  Org                    Org                      @relation(fields: [orgId], references: [id])
  CleaningWorkOrderEvent CleaningWorkOrderEvent[]

  @@index([assignedTo, scheduledDate])
  @@index([orgId, scheduledDate])
  @@index([orgId, status])
}

model CleaningWorkOrderEvent {
  id                String            @id @default(cuid())
  workOrderId       String
  eventType         String
  userId            String?
  timestamp         DateTime          @default(now())
  metadata          Json?
  CleaningWorkOrder CleaningWorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId, timestamp])
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  name             String?
  percentOff       Int?
  amountOffCents   Int?
  duration         String?
  durationMonths   Int?
  startsAt         DateTime?
  endsAt           DateTime?
  maxRedemptions   Int?
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  OnboardingInvite OnboardingInvite[]
}

model Customer {
  id               String             @id @default(cuid())
  orgId            String
  publicId         String             @unique
  company          String?
  primaryName      String?
  primaryEmail     String?
  primaryPhone     String?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  billingSettings  Json               @default("{}")
  tags             String[]           @default([])
  Agreement        Agreement[]
  Org              Org                @relation(fields: [orgId], references: [id])
  CustomerContact  CustomerContact[]
  Invoice          Invoice[]
  Job              Job[]
  Opportunity      Opportunity[]
  RecurringInvoice RecurringInvoice[]
  Communication    Communication[] // Phase 1: Type 2 communications
  CommunicationThread CommunicationThread[] // Phase 1: Message threading

  @@index([orgId, company])
  @@index([orgId, createdAt])
  @@index([orgId, primaryName])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  email      String?
  phone      String?
  role       String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model EmailTemplate {
  id           String   @id @default(cuid())
  orgId        String
  templateType String
  subject      String
  htmlBody     String
  textBody     String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Org          Org      @relation(fields: [orgId], references: [id])

  @@unique([orgId, templateType])
  @@index([orgId, active])
}

model FederationKey {
  id         String    @id @default(cuid())
  tenantId   String
  keyId      String    @unique
  secretHash String
  scope      String
  createdAt  DateTime  @default(now())
  disabledAt DateTime?
  lastUsedAt DateTime?
  rotatedAt  DateTime?

  @@index([keyId, disabledAt])
  @@index([tenantId, scope])
}

model GlobalMonetizationConfig {
  id               String     @id @default(cuid())
  defaultPlanId    String?
  defaultPriceId   String?
  defaultTrialDays Int?       @default(0)
  publicOnboarding Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  PricePlan        PricePlan? @relation(fields: [defaultPlanId], references: [id])
  PlanPrice        PlanPrice? @relation(fields: [defaultPriceId], references: [id])
}

model ImportError {
  id           String    @id @default(cuid())
  importJobId  String
  rowNumber    Int
  fieldName    String?
  errorType    String
  errorMessage String
  rawData      Json?
  createdAt    DateTime  @default(now())
  ImportJob    ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, errorType])
  @@index([importJobId, rowNumber])
}

model ImportJob {
  id               String           @id @default(cuid())
  orgId            String
  userId           String
  entityType       ImportEntityType
  status           ImportStatus     @default(PENDING)
  fileName         String
  fileSize         Int
  fileUrl          String?
  totalRecords     Int              @default(0)
  processedRecords Int              @default(0)
  successCount     Int              @default(0)
  errorCount       Int              @default(0)
  skipCount        Int              @default(0)
  mappingId        String?
  sampleData       Json?
  fieldMappings    Json?
  transformRules   Json?
  validationRules  Json?
  progressPercent  Int              @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  errorSummary     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  ImportError      ImportError[]
  ImportMapping    ImportMapping?   @relation(fields: [mappingId], references: [id])
  Org              Org              @relation(fields: [orgId], references: [id])
  User             User             @relation(fields: [userId], references: [id])

  @@index([orgId, status, createdAt])
  @@index([userId, createdAt])
}

model ImportMapping {
  id              String           @id @default(cuid())
  orgId           String
  name            String
  entityType      ImportEntityType
  sourceFormat    String
  fieldMappings   Json
  transformRules  Json
  validationRules Json
  isTemplate      Boolean          @default(false)
  useCount        Int              @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ImportJob       ImportJob[]
  Org             Org              @relation(fields: [orgId], references: [id])

  @@index([isTemplate, useCount])
  @@index([orgId, entityType])
  @@index([orgId, isTemplate])
}

model Incident {
  id                  String           @id @default(cuid())
  orgId               String
  severity            IncidentSeverity
  status              IncidentStatus   @default(OPEN)
  title               String
  description         String
  assigneeUserId      String?
  slaResponseDeadline DateTime?
  slaResolveDeadline  DateTime?
  acknowledgedAt      DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  Org                 Org              @relation(fields: [orgId], references: [id])

  @@index([orgId, severity])
  @@index([orgId, status, createdAt])
}

model InfrastructureLimit {
  id              String                @id @default(cuid())
  service         InfrastructureService
  metric          MetricType
  currentPlan     String
  limitValue      Float
  warningPercent  Float                 @default(75)
  criticalPercent Float                 @default(90)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([service, metric, currentPlan])
}

model InfrastructureMetric {
  id        String                @id @default(cuid())
  service   InfrastructureService
  metric    MetricType
  value     Float
  timestamp DateTime              @default(now())
  metadata  Json?

  @@index([service, metric, timestamp])
  @@index([timestamp])
}

model Invoice {
  id                   String            @id @default(cuid())
  orgId                String
  customerId           String?
  amount               Decimal           @db.Decimal(12, 2)
  status               String            @default("draft")
  issuedAt             DateTime          @default(now())
  items                Json              @default("[]")
  createdAt            DateTime          @default(now())
  currency             String            @default("USD")
  discountAmount       Decimal           @default(0) @db.Decimal(12, 2)
  dueDate              DateTime?
  jobId                String?
  notes                String?
  number               String?           @unique
  paidAt               DateTime?
  paymentLinkExpiresAt DateTime?
  paymentLinkToken     String?           @unique
  paymentLinkViews     Int               @default(0)
  subtotal             Decimal           @default(0) @db.Decimal(12, 2)
  taxAmount            Decimal           @default(0) @db.Decimal(12, 2)
  terms                String?
  updatedAt            DateTime          @updatedAt
  Customer             Customer?         @relation(fields: [customerId], references: [id])
  Org                  Org               @relation(fields: [orgId], references: [id])
  InvoiceLine          InvoiceLine[]
  InvoiceReminder      InvoiceReminder[]
  Payment              Payment[]

  @@index([number])
  @@index([orgId, customerId])
  @@index([orgId, status, dueDate])
  @@index([paymentLinkToken])
}

model InvoiceLine {
  id             String          @id @default(cuid())
  invoiceId      String
  description    String
  lineType       InvoiceLineType
  quantity       Int             @default(1)
  unitPriceCents Int
  amountCents    Int
  sourceType     String?
  sourceId       String?
  createdAt      DateTime        @default(now())
  Invoice        Invoice         @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([sourceType, sourceId])
}

model InvoiceReminder {
  id           String    @id @default(cuid())
  invoiceId    String
  reminderType String
  status       String    @default("pending")
  sentAt       DateTime?
  error        String?
  createdAt    DateTime  @default(now())
  Invoice      Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status, sentAt])
}

model Job {
  id          String        @id @default(cuid())
  orgId       String
  customerId  String?
  rfpId       String?
  status      String        @default("scheduled")
  schedule    Json          @default("{}")
  assignedTo  String?
  checklist   Json          @default("[]")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  assignees   String[]      @default([])
  completedAt DateTime?
  description String?
  location    Json?
  notes       String?
  scheduledAt DateTime?
  title       String
  Customer    Customer?     @relation(fields: [customerId], references: [id])
  Org         Org           @relation(fields: [orgId], references: [id])
  Rfp         Rfp?          @relation(fields: [rfpId], references: [id])
  JobPhoto    JobPhoto[]
  JobTimeline JobTimeline[]

  @@index([orgId, createdAt])
  @@index([orgId, customerId])
  @@index([orgId, status, scheduledAt])
}

model JobPhoto {
  id        String   @id @default(cuid())
  publicId  String   @unique
  jobId     String
  url       String
  caption   String?
  metadata  Json     @default("{}")
  takenAt   DateTime @default(now())
  takenBy   String?
  createdAt DateTime @default(now())
  Job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([publicId])
}

model JobTimeline {
  id          String   @id @default(cuid())
  publicId    String   @unique
  jobId       String
  eventType   String
  description String
  metadata    Json     @default("{}")
  userId      String?
  createdAt   DateTime @default(now())
  Job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([publicId])
}

model Lead {
  id                    String            @id @default(cuid())
  orgId                 String
  publicId              String            @unique
  sourceType            LeadSource
  identityHash          String
  company               String?
  contactName           String?
  email                 String?
  phoneE164             String?
  website               String?
  serviceCode           String?
  zip                   String?
  enrichmentJson        Json              @default("{}")
  aiScore               Int               @default(0)
  scoreFactors          Json              @default("{}")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @default(now())
  city                  String?
  notes                 String?
  sourceDetail          String?
  state                 String?
  postalCode            String?           @db.VarChar(20)
  address               String?
  addressLine1          String?
  addressLine2          String?
  country               String?
  convertedAt           DateTime?
  rfp                   Json?
  systemGenerated       Boolean           @default(false)
  status                LeadStatus        @default(NEW)
  convertedToCustomerId String?
  customFields          Json              @default("{}")
  Org                   Org               @relation(fields: [orgId], references: [id])
  LeadInvoiceLine       LeadInvoiceLine[]

  @@index([convertedToCustomerId])
  @@index([orgId, convertedAt])
  @@index([orgId, createdAt])
  @@index([orgId, identityHash])
  @@index([orgId, sourceType])
  @@index([orgId, status])
}

model LeadInvoice {
  id              String            @id @default(cuid())
  orgId           String?
  number          String            @unique
  periodFrom      DateTime
  periodTo        DateTime
  status          String
  subtotalCents   Int
  taxCents        Int               @default(0)
  totalCents      Int
  currency        String            @default("usd")
  stripeInvoiceId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  leadCount       Int               @default(0)
  Org             Org?              @relation(fields: [orgId], references: [id])
  LeadInvoiceLine LeadInvoiceLine[]
}

model LeadInvoiceLine {
  id             String      @id @default(cuid())
  invoiceId      String
  leadId         String?
  description    String
