generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/@prisma/client-tenant"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Org {
  id           String   @id @default(cuid())
  name         String
  featureFlags Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // AI Cost Control & Monetization - PROVIDER MODEL
  aiMonthlyBudgetCents Int      @default(5000)  // $50 provider cost limit
  aiCreditBalance     Int      @default(1000)   // 1k credits = $50 worth (1 credit = $0.05 client-facing)
  aiPlan              AiPlan   @default(BASE)   // Client subscription tier
  aiAlerts            Json     @default("{}")   // Usage alert thresholds

  // Stripe Subscription Management
  stripeCustomerId      String?   // Stripe customer ID for billing
  stripeSubscriptionId  String?   // Current active subscription ID
  subscriptionStatus    String?   // active, past_due, canceled, etc
  subscriptionStartDate DateTime? // When subscription started
  subscriptionEndDate   DateTime? // When subscription ends/ended

  // Back-relations
  auditLogs     AuditLog[]
  ledger        BillingLedger[]
  customers     Customer[]
  invoices      Invoice[]
  jobs          Job[]
  leads         Lead[]
  opportunities Opportunity[]
  payments      Payment[]
  referrals     Referral[]
  rfps          Rfp[]
  users         User[]
  rbacRoles     RbacRole[]      @relation("OrgRbacRoles")
  rbacUserRoles RbacUserRole[]  @relation("OrgRbacUserRoles")
  leadInvoices  LeadInvoice[]   @relation("OrgLeadInvoices")
  pricingPlan   PricingPlan?    @relation("OrgPricingPlan")
  aiUsageEvents AiUsageEvent[]  @relation("OrgAiUsageEvents")
  aiMonthlySummaries AiMonthlySummary[] @relation("OrgAiMonthlySummaries")

  // Provider Operations Relations
  activities      Activity[]       @relation("OrgActivities")
  subscriptions   Subscription[]   @relation("OrgSubscriptions")
  usageMeters     UsageMeter[]     @relation("OrgUsageMeters")
  addonPurchases  AddonPurchase[]  @relation("OrgAddonPurchases")

  tenantOverrides  TenantPriceOverride[]

  incidents      Incident[]      @relation("OrgIncidents")
  notifications  Notification[]  @relation("OrgNotifications")

  importJobs     ImportJob[]     @relation("OrgImportJobs")
  importMappings ImportMapping[] @relation("OrgImportMappings")

  /// brandConfig stores white-label brand settings such as name, colors, and logo URL.
  /// It is JSON to allow arbitrary keys like { name: "Mountain Vista", color: "#123456", logoUrl: "https://..." }
  brandConfig Json? @default("{}")

  /// settingsJson stores arbitrary organization-level settings.  This can be used
  /// by owners to configure API keys or other preferences needed at runtime.
  settingsJson Json? @default("{}")
}

model User {
  id                 String   @id @default(cuid())
  orgId              String
  email              String   @unique
  name               String?
  role               Role     @default(STAFF)
  passwordHash       String?  @db.VarChar(255)
  mustChangePassword Boolean  @default(false)
  status             String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Unified Auth System - Security Fields
  isActive              Boolean   @default(true)
  isLocked              Boolean   @default(false)
  lockedUntil           DateTime?
  failedLoginAttempts   Int       @default(0)
  lastFailedLogin       DateTime?
  lastSuccessfulLogin   DateTime?
  lastPasswordChange    DateTime?

  // Two-Factor Authentication (TOTP)
  totpSecret            String?
  totpEnabled           Boolean   @default(false)
  backupCodesHash       String?   // JSON array of hashed backup codes

  org           Org            @relation(fields: [orgId], references: [id])
  rbacUserRoles RbacUserRole[] @relation("UserRbacUserRoles")

  // Unified Auth System - Relations
  recoveryCodes         UserRecoveryCode[]
  breakglassAccount     UserBreakglassAccount?
  securityQuestions     UserSecurityQuestion[]
  loginHistory          UserLoginHistory[]
  deviceFingerprints    UserDeviceFingerprint[]

  importJobs            ImportJob[]        @relation("UserImportJobs")

  @@index([orgId, status, isActive])
  @@index([orgId, role])
  @@index([isActive, isLocked])
}

// ============================================================================
// UNIFIED AUTH SYSTEM - RECOVERY & SECURITY
// ============================================================================

/// Recovery codes for self-service account recovery (Layer 1)
model UserRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    // Bcrypt hashed recovery code
  usedAt    DateTime?
  usedFrom  String?   // IP address where code was used
  createdAt DateTime  @default(now())
  expiresAt DateTime  // Valid for 1 year by default

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([usedAt])
}

/// Security questions for additional verification (Layer 2)
model UserSecurityQuestion {
  id           String   @id @default(cuid())
  userId       String
  question     String   // "What was your first pet's name?"
  answerHash   String   // Bcrypt hashed answer (case-insensitive)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Breakglass account for automated emergency access (Layer 3)
model UserBreakglassAccount {
  id                    String    @id @default(cuid())
  userId                String    @unique
  orgId                 String

  // Encrypted credentials (AES-256-GCM with per-user key derived from master)
  encryptedEmail        String
  encryptedPasswordHash String
  encryptionIV          String    // Initialization vector for decryption

  // Usage tracking
  createdAt             DateTime  @default(now())
  lastActivatedAt       DateTime?
  activationCount       Int       @default(0)

  // Automated security
  isEnabled             Boolean   @default(true)
  canAutoActivate       Boolean   @default(true)  // Can activate without manual approval
  minDelayMinutes       Int       @default(0)     // Minimum delay before activation (risk-based)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
}

/// Device fingerprinting for trust scoring
model UserDeviceFingerprint {
  id              String   @id @default(cuid())
  userId          String

  // Device identification
  fingerprint     String   // Hash of: User-Agent + Screen Resolution + Timezone + Canvas fingerprint
  ipAddress       String
  userAgent       String

  // Trust level
  isTrusted       Boolean  @default(false)
  trustScore      Int      @default(0)  // 0-100

  // Metadata
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  loginCount      Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
  @@index([fingerprint])
}

/// Comprehensive login history for audit trail
model UserLoginHistory {
  id              String   @id @default(cuid())
  userId          String

  // Login details
  success         Boolean
  method          String   // "password", "recovery_code", "breakglass", "totp"
  ipAddress       String
  userAgent       String
  deviceFingerprint String?

  // Risk assessment
  riskScore       Int      @default(0)  // 0-100
  riskFactors     String?  // JSON array of risk factors

  // Geolocation (optional)
  country         String?
  city            String?

  // Metadata
  timestamp       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([success])
  @@index([riskScore])
}

/// Breakglass activation log for automated actions
model BreakglassActivationLog {
  id                String   @id @default(cuid())
  userId            String
  orgId             String

  // Activation details
  reason            String   // "password_reset", "account_locked", "lost_access"
  method            String   // "email_verification", "recovery_code", "security_questions"

  // Risk assessment
  riskScore         Int      // 0-100
  riskFactors       String   // JSON array
  delayMinutes      Int      // How long user had to wait

  // Verification
  verificationSteps String   // JSON array of completed verification steps
  ipAddress         String
  userAgent         String

  // Outcome
  success           Boolean
  errorMessage      String?

  // Notifications sent
  notifiedAdmins    String   // JSON array of admin emails notified

  // Metadata
  timestamp         DateTime @default(now())

  @@index([userId, timestamp])
  @@index([orgId, timestamp])
  @@index([riskScore])
}

/// Pending recovery requests with automated delay timers
model RecoveryRequest {
  id                String    @id @default(cuid())
  userId            String
  orgId             String

  // Request details
  type              String    // "password_reset", "breakglass_activation", "unlock_account"
  status            String    // "pending", "verified", "completed", "expired", "denied"

  // Verification
  verificationToken String    @unique
  verificationCode  String?   // 6-digit code sent via email/SMS
  codeExpiresAt     DateTime?
  codeAttempts      Int       @default(0)

  // Risk-based delay
  riskScore         Int
  delayUntil        DateTime  // When the request can be processed

  // Metadata
  ipAddress         String
  userAgent         String
  createdAt         DateTime  @default(now())
  expiresAt         DateTime  // Request expires after 24 hours
  completedAt       DateTime?

  @@index([userId])
  @@index([verificationToken])
  @@index([status, delayUntil])
}

model Lead {
  id              String     @id @default(cuid())
  orgId           String
  publicId        String     @unique
  sourceType      LeadSource
  identityHash    String
  company         String?
  contactName     String?
  email           String?
  phoneE164       String?
  website         String?
  serviceCode     String?
  zip             String?
  enrichmentJson  Json       @default("{}")
  aiScore         Int        @default(0)
  scoreFactors    Json       @default("{}")
  /// systemGenerated: true if lead came from SAM/automated import
  systemGenerated Boolean    @default(false)
  /// convertedAt: timestamp when lead was converted (if status changes to converted)
  convertedAt     DateTime?
  convertedToCustomerId String?
  /// rfp: raw RFP metadata from SAM.gov
  rfp             Json?
  /// Status of the lead. Stored as an enum rather than string for consistency.
  status          LeadStatus @default(NEW)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  city            String?
  notes           String?
  sourceDetail    String?
  state           String?
  postalCode      String?    @db.VarChar(20)
  address         String?
  addressLine1    String?
  addressLine2    String?
  country         String?
  customFields    Json       @default("{}")

  org             Org               @relation(fields: [orgId], references: [id])
  LeadInvoiceLine LeadInvoiceLine[]
  @@index([orgId, createdAt])
  @@index([orgId, convertedAt])
  @@index([orgId, status])
  @@index([orgId, sourceType])
  @@index([orgId, identityHash])
  @@index([convertedToCustomerId])
}

model Customer {
  id           String   @id @default(cuid())
  orgId        String
  publicId     String   @unique
  company      String?
  primaryName  String?
  primaryEmail String?
  primaryPhone String?
  notes        String?
  tags         String[] @default([])
  billingSettings Json  @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org           Org           @relation(fields: [orgId], references: [id])
  invoices      Invoice[]
  jobs          Job[]
  opportunities Opportunity[]
  agreements    Agreement[]
  contacts      CustomerContact[]

  @@index([orgId, createdAt])
  @@index([orgId, company])
  @@index([orgId, primaryName])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  email      String?
  phone      String?
  role       String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Opportunity {
  id             String    @id @default(cuid())
  orgId          String
  customerId     String
  valueType      ValueType @default(RELATIONSHIP)
  estValue       Decimal?  @db.Decimal(12, 2)
  stage          String    @default("new")
  ownerId        String?
  sourceLeadId   String?
  classification Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  org      Org      @relation(fields: [orgId], references: [id])
}

model Invoice {
  id          String   @id @default(cuid())
  orgId       String
  customerId  String?
  jobId       String?
  number      String?  @unique
  amount      Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2) @default(0)
  taxAmount   Decimal  @db.Decimal(12, 2) @default(0)
  discountAmount Decimal @db.Decimal(12, 2) @default(0)
  status      String   @default("draft")
  dueDate     DateTime?
  issuedAt    DateTime @default(now())
  paidAt      DateTime?
  items       Json     @default("[]")
  terms       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lineItems   InvoiceLine[]

  customer Customer? @relation(fields: [customerId], references: [id])
  org      Org       @relation(fields: [orgId], references: [id])
  payments Payment[]

  @@index([orgId, status, dueDate])
  @@index([orgId, customerId])
  @@index([number])
}

model Payment {
  id         String   @id @default(cuid())
  orgId      String
  invoiceId  String?
  amount     Decimal  @db.Decimal(12, 2)
  method     String   @default("stripe")
  receivedAt DateTime @default(now())
  reference  String?

  // Enhancements for Stripe/dunning
  status                 String   @default("succeeded") // 'pending' | 'succeeded' | 'failed' | 'refunded'
  stripePaymentIntentId  String?
  stripeChargeId         String?
  failureReason          String?
  retryCount             Int      @default(0)
  lastRetryAt            DateTime?

  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  org     Org      @relation(fields: [orgId], references: [id])

  @@index([orgId, status])
  @@index([stripePaymentIntentId])
  @@index([stripeChargeId])
}

model Rfp {
  id          String    @id @default(cuid())
  orgId       String
  publicId    String    @unique
  sourceSite  String
  title       String
  dueDate     DateTime?
  docs        Json      @default("[]")
  aiBidFit    Int?
  aiPriceHint Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  jobs Job[]
  org  Org   @relation(fields: [orgId], references: [id])
}

model Job {
  id          String   @id @default(cuid())
  orgId       String
  customerId  String?
  rfpId       String?
  title       String
  description String?
  status      String   @default("scheduled")
  schedule    Json     @default("{}")
  scheduledAt DateTime?
  completedAt DateTime?
  assignedTo  String?
  assignees   String[] @default([])
  location    Json?    // { lat, lng, address }
  checklist   Json     @default("[]")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id])
  org      Org        @relation(fields: [orgId], references: [id])
  rfp      Rfp?       @relation(fields: [rfpId], references: [id])
  photos   JobPhoto[]
  timeline JobTimeline[]

  @@index([orgId, status, scheduledAt])
  @@index([orgId, customerId])
  @@index([orgId, createdAt])
}

model JobPhoto {
  id        String   @id @default(cuid())
  publicId  String   @unique @default(cuid())
  jobId     String
  url       String
  caption   String?
  metadata  Json     @default("{}")
  takenAt   DateTime @default(now())
  takenBy   String?
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([publicId])
}

model JobTimeline {
  id          String   @id @default(cuid())
  publicId    String   @unique @default(cuid())
  jobId       String
  eventType   String
  description String
  metadata    Json     @default("{}")
  userId      String?
  createdAt   DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([publicId])
}

model Referral {
  id            String    @id @default(cuid())
  orgId         String
  employeeId    String?
  referredName  String
  referredEmail String?
  referredPhone String?
  status        String    @default("new")
  convertedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org Org @relation(fields: [orgId], references: [id])
}

model AgreementTemplate {
  id          String   @id @default(cuid())
  orgId       String?
  name        String
  verticalKey String?
  content     String   @db.Text
  mergeFields Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agreements Agreement[]

  @@index([orgId, isActive])
  @@index([verticalKey])
}

model Agreement {
  id          String    @id @default(cuid())
  orgId       String
  customerId  String
  templateId  String
  status      String    @default("draft")
  content     String    @db.Text
  variables   Json      @default("{}")
  signUrl     String?
  signedAt    DateTime?
  signedBy    String?
  renewalAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id])
  template AgreementTemplate @relation(fields: [templateId], references: [id])

  @@index([orgId, status, renewalAt])
  @@index([customerId])
}

model BillingLedger {
  id        String     @id @default(cuid())
  orgId     String
  type      LedgerType
  amount    Decimal    @db.Decimal(12, 2)
  meta      Json       @default("{}")
  createdAt DateTime   @default(now())

  org Org @relation(fields: [orgId], references: [id])

  @@index([orgId, type])
}

/// LeadInvoice represents a monthly invoice for converted leads. This is separate from the
/// existing Invoice model used for customers/jobs. It aggregates lead conversions and
/// includes metadata to support billing and optional Stripe integration.
model LeadInvoice {
  id              String   @id @default(cuid())
  orgId           String?
  org             Org?     @relation("OrgLeadInvoices", fields: [orgId], references: [id])
  number          String   @unique
  periodFrom      DateTime
  periodTo        DateTime
  status          String // "draft" | "open" | "paid" | "void" | "uncollectible"
  subtotalCents   Int
  taxCents        Int      @default(0)
  totalCents      Int
  currency        String   @default("usd")
  stripeInvoiceId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  /// Number of leads billed on this invoice (to support flat-per-lead billing)
  leadCount       Int      @default(0)

  lines LeadInvoiceLine[]
}

/// LeadInvoiceLine represents an individual line item on a LeadInvoice. Each line is typically
/// associated with a converted lead, but generic fee/credit lines are also supported.
model LeadInvoiceLine {
  id        String      @id @default(cuid())
  invoiceId String
  invoice   LeadInvoice @relation(fields: [invoiceId], references: [id])

  // Optional association back to a Lead for traceability.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  description    String
  quantity       Int      @default(1)
  unitPriceCents Int
  amountCents    Int
  source         String?
  createdAt      DateTime @default(now())

  @@index([invoiceId])
  @@index([leadId])
}

model AuditLog {
  id          String   @id @default(cuid())
  orgId       String
  actorUserId String?
  /// The entity type affected (e.g. 'lead', 'invoice', 'pricing', etc.)
  entity      String
  /// Identifier of the record affected
  entityId    String?
  /// Name of the field that was changed (nullable for record-level actions)
  field       String?
  /// Previous value (JSON) before the change, if applicable
  oldValue    Json?
  /// New value (JSON) after the change, if applicable
  newValue    Json?
  /// Free-form reason or comment describing why the change was made
  reason      String?
  createdAt   DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, entity, createdAt])
  @@index([actorUserId, createdAt])
}

enum Role {
  OWNER
  MANAGER
  STAFF
  PROVIDER
  ACCOUNTANT
}

enum LeadSource {
  COLD
  HOT
  RFP
  MANUAL_EMPLOYEE_REFERRAL
  MANUAL_EXISTING_CUSTOMER
  MANUAL_NEW_CUSTOMER
  MANUAL_OTHER
  /// System-generated leads imported from external sources like SAM.gov
  SYSTEM
  /// Employee referrals (for internal referral program)
  EMPLOYEE_REFERRAL
  /// Manually added leads not fitting other categories
  MANUAL
  /// Leads imported from Local Service Ads or other lead sources
  LSA
}

enum ValueType {
  RELATIONSHIP
  JOB
}

enum LedgerType {
  CONVERSION_FEE
  PACK_PURCHASE
}

// === RBAC (namespaced to avoid collision with your existing Role enum) ===

model RbacPermission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "lead:create"
  description String?
  createdAt   DateTime @default(now())

  rolePerms RbacRolePermission[]
}

model RbacRole {
  id        String   @id @default(cuid())
  orgId     String?
  // 👇 keep the named relation to match Org.rbacRoles
  org       Org?     @relation("OrgRbacRoles", fields: [orgId], references: [id])
  name      String
  slug      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  rolePerms RbacRolePermission[]
  userRoles RbacUserRole[]

  @@unique([orgId, slug])
}

model RbacRolePermission {
  roleId       String
  permissionId String

  role       RbacRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission RbacPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RbacUserRole {
  id     String  @id @default(cuid())
  userId String
  orgId  String?
  roleId String

  // 👇 named relations to match Org/User sides
  user User     @relation("UserRbacUserRoles", fields: [userId], references: [id], onDelete: Cascade)
  org  Org?     @relation("OrgRbacUserRoles", fields: [orgId], references: [id])
  role RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, orgId])
}

/// ProviderConfig holds provider-level secrets and configuration separate from any organization.
/// These values are used for system integrations that the provider controls, such as SAM.gov or
/// Stripe secrets used when billing clients.  Only one row is typically used.  Use a simple
/// admin interface to update these values.
model ProviderConfig {
  id              String   @id @default(cuid())
  samApiKey       String?
  stripeSecretKey String?
  otherConfig     Json?    @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// PricingPlan defines how an organization is billed for leads. Each org can have only
/// one pricing plan record. A plan specifies the billing model (e.g. per-lead fixed fee)
/// and can include tiered structures or prepaid units via includedUnits and tiersJson.
model PricingPlan {
  // We keep FK as primary key to enforce 1:1 with Org
  orgId String @id
  /// Relation to organization (named to match Org.pricingPlan)
  org   Org    @relation("OrgPricingPlan", fields: [orgId], references: [id])

  /// Billing model used for this organization (per-lead, tiered, subscription, or hybrid)
  model         PricingModel @default(PER_LEAD_FIXED)
  /// ISO currency code (e.g. "usd")
  currency      String       @default("usd")
  /// Fixed unit price in cents for per-lead billing
  unitAmount    Int          @default(10000)
  /// JSON-encoded pricing tiers (used when model is TIERED or HYBRID)
  tiersJson     Json?
  /// Number of prepaid leads included before billing starts
  includedUnits Int          @default(0)
}

/// PricingModel enumerates the possible billing models for lead invoices.  The default is
/// PER_LEAD_FIXED which charges a flat fee per converted lead.  Additional models support
/// tiered pricing, subscription (monthly base fee), or hybrid structures.
enum PricingModel {
  PER_LEAD_FIXED
  TIERED
  SUBSCRIPTION
  HYBRID
}

/// LeadStatus defines the possible states of a lead in the pipeline.  The default is
/// NEW and transitions to CONVERTED when the lead is converted into a paying job.
enum LeadStatus {
  NEW
  CONVERTED
}

// AI Plan Tiers for Monetization - CLIENT SUBSCRIPTION TIERS
enum AiPlan {
  BASE    // MVP: Free lead generation, $100/conversion only
  PRO     // $97/month: Advanced AI, unlimited leads, priority support
  ELITE   // $297/month: Market intelligence, priority RFPs, dedicated support
}

// Individual AI API call tracking for cost monitoring and analytics
model AiUsageEvent {
  id          String   @id @default(cuid())
  orgId       String
  userId      String?  // Optional user who triggered the call
  feature     String   // 'lead_analysis', 'rfp_strategy', 'pricing', 'response_gen'
  model       String   // 'gpt-4o-mini', etc
  tokensIn    Int      // Input tokens consumed
  tokensOut   Int      // Output tokens generated
  costUsd     Decimal  @db.Decimal(8, 6)  // Actual cost in USD (precise to $0.000001)
  creditsUsed Int      // Credits deducted from user's balance
  requestId   String?  // For request correlation and debugging
  createdAt   DateTime @default(now())

  org Org @relation("OrgAiUsageEvents", fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, feature])
}

// Monthly AI usage rollups for dashboard and billing
model AiMonthlySummary {
  id          String   @id @default(cuid())
  orgId       String
  monthKey    String   // Format: "2025-01" for January 2025
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  costUsd     Decimal  @db.Decimal(8, 2)  @default(0)
  creditsUsed Int      @default(0)
  callCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Org @relation("OrgAiMonthlySummaries", fields: [orgId], references: [id])

  @@unique([orgId, monthKey])
  @@index([monthKey])
}

// ============================================================================
// PROVIDER OPERATIONS - ACTIVITY TIMELINE
// ============================================================================

/// Activity tracks cross-entity timeline events for provider operations
/// Used for unified activity feeds across leads, invoices, incidents, etc.
model Activity {
  id         String   @id @default(cuid())
  orgId      String
  actorType  String   // 'system' | 'user' | 'machine'
  actorId    String?
  entityType String   // 'lead' | 'invoice' | 'incident' | 'subscription' | etc.
  entityId   String
  action     String   // 'created' | 'updated' | 'converted' | 'paid' | etc.
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  org Org @relation("OrgActivities", fields: [orgId], references: [id])

  @@index([orgId, entityType, entityId, createdAt])
  @@index([orgId, createdAt])
}

// ============================================================================
// PROVIDER OPERATIONS - SUBSCRIPTION MANAGEMENT
// ============================================================================

/// Subscription tracks plan lifecycle for provider billing operations
/// Supports MRR/ARR calculations, churn analysis, and plan changes
model Subscription {
  id         String    @id @default(cuid())
  orgId      String
  plan       String    // Plan identifier (e.g., 'starter', 'professional', 'enterprise')
  status     String    // 'trialing' | 'active' | 'past_due' | 'canceled'
  startedAt  DateTime
  canceledAt DateTime?
  renewsAt   DateTime?
  priceCents Int       // Monthly price in cents
  meta       Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org Org @relation("OrgSubscriptions", fields: [orgId], references: [id])

  @@index([orgId, status])
  @@index([status, renewsAt])
}

// ============================================================================
// PROVIDER OPERATIONS - USAGE METERING
// ============================================================================

/// UsageMeter records raw usage units before rating/billing
/// Used for usage-based billing and cost tracking
model UsageMeter {
  id          String   @id @default(cuid())
  orgId       String
  meter       String   // Meter identifier (e.g., 'emails_sent', 'api_calls', 'storage_gb')
  quantity    Int      // Raw quantity for the window
  windowStart DateTime // Start of measurement window
  windowEnd   DateTime // End of measurement window
  createdAt   DateTime @default(now())

  org Org @relation("OrgUsageMeters", fields: [orgId], references: [id])

  @@index([orgId, meter, windowStart])
  @@index([windowStart, windowEnd])
}

// ============================================================================
// PROVIDER OPERATIONS - ADD-ON PURCHASES
// ============================================================================

/// AddonPurchase tracks one-off purchases and refunds
/// Used for add-on revenue tracking and reconciliation
model AddonPurchase {
  id          String    @id @default(cuid())
  orgId       String
  sku         String    // SKU identifier (e.g., 'extra_storage_100gb', 'priority_support')
  amount      Decimal   @db.Decimal(12, 2)
  status      String    // 'purchased' | 'refunded'
  purchasedAt DateTime  @default(now())
  refundedAt  DateTime?
  meta        Json      @default("{}")

  org Org @relation("OrgAddonPurchases", fields: [orgId], references: [id])

  @@index([orgId, sku, status])
  @@index([purchasedAt])
}

// ============================================================================
// PROVIDER OPERATIONS - FEDERATION KEY MANAGEMENT
// ============================================================================

/// FederationKey stores HMAC keys for provider-side federation
/// Used for secure machine-to-machine authentication
model FederationKey {
  id         String    @id @default(cuid())
  tenantId   String    // Tenant identifier (orgId or external ID)
  keyId      String    @unique // Public key identifier
  secretHash String    // Hashed secret for HMAC verification
  scope      String    // 'events' | 'usage' | 'billing' | 'all'
  createdAt  DateTime  @default(now())
  disabledAt DateTime? // When key was disabled (soft delete)
  rotatedAt  DateTime? // When key was last rotated
  lastUsedAt DateTime? // Last time key was used for authentication

  @@index([tenantId, scope])
  @@index([keyId, disabledAt])
}

/// OIDCConfig stores OIDC/OAuth provider configuration for federation
model OIDCConfig {
  id            String    @id @default(cuid())
  enabled       Boolean   @default(false)
  issuerUrl     String    // OIDC issuer URL
  clientId      String    // OAuth client ID
  clientSecret  String    // Encrypted OAuth client secret
  scopes        String    @default("openid profile email") // Space-separated scopes
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastTestedAt  DateTime? // Last successful connection test
}

/// ProviderIntegration tracks external provider connections
model ProviderIntegration {
  id                  String    @id @default(cuid())
  name                String    // Provider name (e.g., "Acme Corp")
  url                 String?   // Provider URL for connectivity tests
  type                String    // 'oidc' | 'saml' | 'api_key' | 'oauth'
  config              Json      @default("{}") // Provider-specific configuration
  enabled             Boolean   @default(true)
  healthStatus        String?   // 'healthy' | 'degraded' | 'down' | 'unknown'
  syncStatus          String?   // 'success' | 'failed' | 'pending' | 'never'
  errorMessage        String?   // Last error message if any
  lastSyncAt          DateTime? // Last successful sync
  lastHealthCheckAt   DateTime? // Last health check timestamp
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([type, enabled])
  @@index([healthStatus])
  @@index([syncStatus])
}

/// AuditEvent stores provider-side audit trail
model AuditEvent {
  id          String   @id @default(cuid())
  actorType   String   // 'provider' | 'system' | 'user'
  actorId     String?  // Provider user ID or system identifier
  action      String   // 'create' | 'update' | 'delete' | 'access'
  entityType  String   // 'federation_key' | 'oidc_config' | 'client' | etc.
  entityId    String?  // ID of affected entity
  metadata    Json     @default("{}") // Additional context (redacted PII)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

/// AnalyticsSnapshot stores daily aggregated metrics for caching
model AnalyticsSnapshot {
  id              String   @id @default(cuid())
  snapshotDate    DateTime @db.Date // Date of snapshot
  mrrCents        Int      @default(0) // Monthly Recurring Revenue in cents
  arrCents        Int      @default(0) // Annual Recurring Revenue in cents
  activeClients   Int      @default(0)
  newClients      Int      @default(0)
  churnedClients  Int      @default(0)
  totalRevenue    Int      @default(0) // Total revenue in cents
  metricsJson     Json     @default("{}") // Additional metrics
  createdAt       DateTime @default(now())

  @@unique([snapshotDate])
  @@index([snapshotDate])
}

// ============================================================================
// PROVIDER CONTROL CENTER - NEW MODELS (GPT-5)
// ============================================================================

/// Incident lifecycle tracking with SLA fields
model Incident {
  id                   String   @id @default(cuid())
  orgId                String
  severity             IncidentSeverity
  status               IncidentStatus    @default(OPEN)
  title                String
  description          String
  assigneeUserId       String?
  slaResponseDeadline  DateTime?
  slaResolveDeadline   DateTime?
  acknowledgedAt       DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  org Org @relation("OrgIncidents", fields: [orgId], references: [id])

  @@index([orgId, status, createdAt])
  @@index([orgId, severity])
}

/// InvoiceLine ties granular charges to Invoices
model InvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  description     String
  lineType        InvoiceLineType
  quantity        Int      @default(1)
  unitPriceCents  Int
  amountCents     Int
  sourceType      String?
  sourceId        String?
  createdAt       DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([sourceType, sourceId])
}

/// Provider in-app notifications
model Notification {
  id        String   @id @default(cuid())
  orgId     String?
  audience  String   // 'provider' | 'developer'
  type      String
  title     String
  body      String
  severity  String   // 'info' | 'warning' | 'error'
  readAt    DateTime?
  createdAt DateTime @default(now())

  org Org? @relation("OrgNotifications", fields: [orgId], references: [id])

  @@index([orgId, createdAt])
}

enum IncidentSeverity {
  P1
  P2
  P3
}

enum IncidentStatus {
  OPEN
  ACK
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum InvoiceLineType {
  subscription
  usage
  addon
  one_time
}


// ============================================================================
// MONETIZATION CORE (Plans, Prices, Offers, Coupons, Overrides, Global Config)
// ============================================================================

enum BillingCadence {
  MONTHLY
  YEARLY
}

enum OverrideType {
  FREE
  DISCOUNT
  CUSTOM_AMOUNT
}

model PricePlan {
  id          String      @id @default(cuid())
  key         String      @unique           // e.g. "starter", "pro", "enterprise"
  name        String
  description String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  prices      PlanPrice[]
  offers      Offer[]
  overrides   TenantPriceOverride[]
  asDefaultFor GlobalMonetizationConfig[]
  invites     OnboardingInvite[]
}

model PlanPrice {
  id              String         @id @default(cuid())
  planId          String
  currency        String         @default("usd")
  unitAmountCents Int            // 999 = $9.99
  cadence         BillingCadence @default(MONTHLY)
  trialDays       Int?           @default(0)
  active          Boolean        @default(true)
  stripePriceId   String?        // optional mapping
  createdAt       DateTime       @default(now())
  overrides   TenantPriceOverride[]
  asDefaultFor GlobalMonetizationConfig[]
  invites     OnboardingInvite[]

  updatedAt       DateTime       @updatedAt

  plan PricePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, active])
  @@index([stripePriceId])
}

model Offer {
  id              String      @id @default(cuid())
  name            String
  percentOff      Int?        // 1..100
  amountOffCents  Int?
  duration        String?     // 'once' | 'repeating' | 'forever'
  durationMonths  Int?
  appliesToPlanId String?
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  appliesToPlan PricePlan? @relation(fields: [appliesToPlanId], references: [id])
  invites       OnboardingInvite[]
}

model Coupon {
  id              String      @id @default(cuid())
  code            String      @unique
  name            String?
  percentOff      Int?
  amountOffCents  Int?
  duration        String?     // 'once' | 'repeating' | 'forever'
  durationMonths  Int?
  startsAt        DateTime?
  endsAt          DateTime?
  maxRedemptions  Int?
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  invites       OnboardingInvite[]
}

model TenantPriceOverride {
  id              String        @id @default(cuid())
  orgId           String
  planId          String?
  priceId         String?
  type            OverrideType  @default(DISCOUNT)
  percentOff      Int?
  amountOffCents  Int?
  priceCents      Int?
  startsAt        DateTime?
  endsAt          DateTime?
  reason          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  org   Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan  PricePlan? @relation(fields: [planId], references: [id])
  price PlanPrice? @relation(fields: [priceId], references: [id])

  @@index([orgId])
  @@index([planId])
  @@index([priceId])
}

model GlobalMonetizationConfig {
  id               String   @id @default(cuid())
  defaultPlanId    String?
  defaultPriceId   String?
  defaultTrialDays Int?     @default(0)
  publicOnboarding Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  defaultPlan  PricePlan? @relation(fields: [defaultPlanId], references: [id])
  defaultPrice PlanPrice? @relation(fields: [defaultPriceId], references: [id])
}

model OnboardingInvite {
  id         String   @id @default(cuid())
  token      String   @unique
  email      String?
  planId     String?
  priceId    String?
  offerId    String?
  couponId   String?
  trialDays  Int?     @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  note       String?
  createdAt  DateTime @default(now())

  plan   PricePlan? @relation(fields: [planId], references: [id])
  price  PlanPrice? @relation(fields: [priceId], references: [id])
  offer  Offer?     @relation(fields: [offerId], references: [id])
  coupon Coupon?    @relation(fields: [couponId], references: [id])

  @@index([expiresAt, usedAt])
}

// ============================================================================
// Infrastructure Monitoring Models
// ============================================================================

enum InfrastructureService {
  VERCEL_KV
  VERCEL_POSTGRES
  VERCEL_PLATFORM
  VERCEL_BUILD
  VERCEL_FUNCTIONS
  VERCEL_BANDWIDTH
  VERCEL_EDGE_REQUESTS
  VERCEL_ISR_READS
  AI_OPENAI
  AI_CREDITS
}

enum MetricType {
  STORAGE_MB
  STORAGE_GB
  COMMANDS_PER_DAY
  CONNECTIONS
  LATENCY_MS
  BANDWIDTH_GB
  INVOCATIONS
  BUILD_MINUTES
  REQUEST_COUNT
  COST_USD
  USAGE_PERCENT
}

enum RecommendationPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RecommendationStatus {
  PENDING
  REVIEWED
  ACKNOWLEDGED
  IMPLEMENTED
  DISMISSED
}

model InfrastructureMetric {
  id        String                 @id @default(cuid())
  service   InfrastructureService
  metric    MetricType
  value     Float
  timestamp DateTime               @default(now())
  metadata  Json?

  @@index([service, metric, timestamp])
  @@index([timestamp])
}

model InfrastructureLimit {
  id              String                 @id @default(cuid())
  service         InfrastructureService
  metric          MetricType
  currentPlan     String
  limitValue      Float
  warningPercent  Float                  @default(75)  // Warning threshold percentage
  criticalPercent Float                  @default(90)  // Critical threshold percentage
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([service, metric, currentPlan])
}

/// Import Wizard - Data Migration Models
enum ImportStatus {
  PENDING
  ANALYZING
  MAPPING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportEntityType {
  CUSTOMERS
  JOBS
  INVOICES
  ESTIMATES
  CONTACTS
  ADDRESSES
  NOTES
}

model ImportJob {
  id              String            @id @default(cuid())
  orgId           String
  org             Org               @relation("OrgImportJobs", fields: [orgId], references: [id])
  userId          String
  user            User              @relation("UserImportJobs", fields: [userId], references: [id])
  entityType      ImportEntityType
  status          ImportStatus      @default(PENDING)
  fileName        String
  fileSize        Int               // bytes
  totalRecords    Int               @default(0)
  processedRecords Int              @default(0)
  successCount    Int               @default(0)
  errorCount      Int               @default(0)
  skipCount       Int               @default(0)
  mappingId       String?
  mapping         ImportMapping?    @relation(fields: [mappingId], references: [id])
  sampleData      Json?             // First 10 rows for preview
  fieldMappings   Json?             // Field mapping configuration
  transformRules  Json?             // Data transformation rules
  validationRules Json?             // Validation configuration
  progressPercent Int               @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  errorSummary    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  errors          ImportError[]

  @@index([orgId, status, createdAt])
  @@index([userId, createdAt])
}

model ImportMapping {
  id              String            @id @default(cuid())
  orgId           String
  org             Org               @relation("OrgImportMappings", fields: [orgId], references: [id])
  name            String            // User-friendly name (e.g., "QuickBooks Customer Import")
  entityType      ImportEntityType
  sourceFormat    String            // csv, excel, json, xml
  fieldMappings   Json              // Source field → Cortiware field mappings
  transformRules  Json              // Data transformation rules
  validationRules Json              // Validation configuration
  isTemplate      Boolean           @default(false)
  useCount        Int               @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  jobs            ImportJob[]

  @@index([orgId, entityType])
  @@index([orgId, isTemplate])
}

model ImportError {
  id              String      @id @default(cuid())
  importJobId     String
  importJob       ImportJob   @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber       Int
  fieldName       String?
  errorType       String      // validation, transformation, duplicate, missing_required
  errorMessage    String
  rawData         Json?       // Original row data for debugging
  createdAt       DateTime    @default(now())

  @@index([importJobId, errorType])
  @@index([importJobId, rowNumber])
}

model UpgradeRecommendation {
  id                String                  @id @default(cuid())
  service           InfrastructureService
  currentPlan       String
  recommendedPlan   String
  priority          RecommendationPriority
  status            RecommendationStatus    @default(PENDING)
  reason            String
  currentUsage      Float?                  // Current usage value
  limitValue        Float?                  // Limit value for the metric
  usagePercent      Float?                  // Usage as percentage
  daysToLimit       Int?                    // Days until limit is reached
  currentCost       Float?                  // Current monthly cost
  projectedCost     Float?                  // Projected monthly cost
  upgradeCost       Float?                  // Upgraded plan monthly cost
  revenueImpact     Float?                  // Estimated revenue impact
  profitImpact      Float?                  // Estimated profit impact
  roi               Float?                  // Return on investment percentage
  benefits          String?                 // Benefits of upgrading
  risks             String?                 // Risks of not upgrading
  estimatedCostUsd  Float?                  // Deprecated: use currentCost
  estimatedSavings  Float?                  // Deprecated: use revenueImpact
  roiMonths         Int?                    // Deprecated: use roi
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  acknowledgedAt    DateTime?
  implementedAt     DateTime?

  @@index([service, status])
  @@index([priority, status])
}

/// RefreshToken stores long-lived refresh tokens for token rotation
/// Used with short-lived access tokens for improved security
model RefreshToken {
  id         String   @id @default(cuid())
  sessionId  String   @unique
  userId     String
  email      String
  role       String
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}
