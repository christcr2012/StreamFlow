generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/@prisma/client-tenant"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Org {
  id                    String                @id @default(cuid())
  name                  String
  featureFlags          Json                  @default("{}")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  /// brandConfig stores white-label brand settings such as name, colors, and logo URL.
  /// It is JSON to allow arbitrary keys like { name: "Mountain Vista", color: "#123456", logoUrl: "https://..." }
  brandConfig           Json?                 @default("{}")
  /// settingsJson stores arbitrary organization-level settings.  This can be used
  /// by owners to configure API keys or other preferences needed at runtime.
  settingsJson          Json?                 @default("{}")
  aiAlerts              Json                  @default("{}")
  aiCreditBalance       Int                   @default(1000)
  aiMonthlyBudgetCents  Int                   @default(5000)
  aiPlan                AiPlan                @default(BASE)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  subscriptionEndDate   DateTime?
  subscriptionStartDate DateTime?
  subscriptionStatus    String?
  activities            Activity[]            @relation("OrgActivities")
  addonPurchases        AddonPurchase[]       @relation("OrgAddonPurchases")
  aiMonthlySummaries    AiMonthlySummary[]    @relation("OrgAiMonthlySummaries")
  aiUsageEvents         AiUsageEvent[]        @relation("OrgAiUsageEvents")
  auditLogs             AuditLog[]
  ledger                BillingLedger[]
  customers             Customer[]
  incidents             Incident[]            @relation("OrgIncidents")
  invoices              Invoice[]
  jobs                  Job[]
  leads                 Lead[]
  leadInvoices          LeadInvoice[]         @relation("OrgLeadInvoices")
  notifications         Notification[]        @relation("OrgNotifications")
  opportunities         Opportunity[]
  payments              Payment[]
  pricingPlan           PricingPlan?          @relation("OrgPricingPlan")
  rbacRoles             RbacRole[]            @relation("OrgRbacRoles")
  rbacUserRoles         RbacUserRole[]        @relation("OrgRbacUserRoles")
  referrals             Referral[]
  rfps                  Rfp[]
  subscriptions         Subscription[]        @relation("OrgSubscriptions")
  tenantOverrides       TenantPriceOverride[]
  usageMeters           UsageMeter[]          @relation("OrgUsageMeters")
  users                 User[]
}

model User {
  id                  String                  @id @default(cuid())
  orgId               String
  email               String                  @unique
  name                String?
  role                Role                    @default(STAFF)
  status              String                  @default("active")
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  mustChangePassword  Boolean                 @default(false)
  passwordHash        String?                 @db.VarChar(255)
  backupCodesHash     String?
  failedLoginAttempts Int                     @default(0)
  isActive            Boolean                 @default(true)
  isLocked            Boolean                 @default(false)
  lastFailedLogin     DateTime?
  lastPasswordChange  DateTime?
  lastSuccessfulLogin DateTime?
  lockedUntil         DateTime?
  totpEnabled         Boolean                 @default(false)
  totpSecret          String?
  rbacUserRoles       RbacUserRole[]          @relation("UserRbacUserRoles")
  org                 Org                     @relation(fields: [orgId], references: [id])
  breakglassAccount   UserBreakglassAccount?
  deviceFingerprints  UserDeviceFingerprint[]
  loginHistory        UserLoginHistory[]
  recoveryCodes       UserRecoveryCode[]
  securityQuestions   UserSecurityQuestion[]
}

/// Recovery codes for self-service account recovery (Layer 1)
model UserRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  usedFrom  String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([usedAt])
}

/// Security questions for additional verification (Layer 2)
model UserSecurityQuestion {
  id         String   @id @default(cuid())
  userId     String
  question   String
  answerHash String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Breakglass account for automated emergency access (Layer 3)
model UserBreakglassAccount {
  id                    String    @id @default(cuid())
  userId                String    @unique
  orgId                 String
  encryptedEmail        String
  encryptedPasswordHash String
  encryptionIV          String
  createdAt             DateTime  @default(now())
  lastActivatedAt       DateTime?
  activationCount       Int       @default(0)
  isEnabled             Boolean   @default(true)
  canAutoActivate       Boolean   @default(true)
  minDelayMinutes       Int       @default(0)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
}

/// Device fingerprinting for trust scoring
model UserDeviceFingerprint {
  id          String   @id @default(cuid())
  userId      String
  fingerprint String
  ipAddress   String
  userAgent   String
  isTrusted   Boolean  @default(false)
  trustScore  Int      @default(0)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  loginCount  Int      @default(1)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
  @@index([fingerprint])
}

/// Comprehensive login history for audit trail
model UserLoginHistory {
  id                String   @id @default(cuid())
  userId            String
  success           Boolean
  method            String
  ipAddress         String
  userAgent         String
  deviceFingerprint String?
  riskScore         Int      @default(0)
  riskFactors       String?
  country           String?
  city              String?
  timestamp         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([success])
  @@index([riskScore])
}

/// Breakglass activation log for automated actions
model BreakglassActivationLog {
  id                String   @id @default(cuid())
  userId            String
  orgId             String
  reason            String
  method            String
  riskScore         Int
  riskFactors       String
  delayMinutes      Int
  verificationSteps String
  ipAddress         String
  userAgent         String
  success           Boolean
  errorMessage      String?
  notifiedAdmins    String
  timestamp         DateTime @default(now())

  @@index([userId, timestamp])
  @@index([orgId, timestamp])
  @@index([riskScore])
}

/// Pending recovery requests with automated delay timers
model RecoveryRequest {
  id                String    @id @default(cuid())
  userId            String
  orgId             String
  type              String
  status            String
  verificationToken String    @unique
  verificationCode  String?
  codeExpiresAt     DateTime?
  codeAttempts      Int       @default(0)
  riskScore         Int
  delayUntil        DateTime
  ipAddress         String
  userAgent         String
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  completedAt       DateTime?

  @@index([userId])
  @@index([verificationToken])
  @@index([status, delayUntil])
}

model Lead {
  id                   String              @id @default(cuid())
  orgId                String
  publicId             String              @unique
  sourceType           LeadSource
  identityHash         String
  company              String?
  contactName          String?
  email                String?
  phoneE164            String?
  website              String?
  serviceCode          String?
  zip                  String?
  enrichmentJson       Json                @default("{}")
  aiScore              Int                 @default(0)
  scoreFactors         Json                @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  city                 String?
  notes                String?
  sourceDetail         String?
  state                String?
  postalCode           String?             @db.VarChar(20)
  address              String?
  addressLine1         String?
  addressLine2         String?
  country              String?
  /// convertedAt: timestamp when lead was converted (if status changes to converted)
  convertedAt          DateTime?
  /// rfp: raw RFP metadata from SAM.gov
  rfp                  Json?
  /// systemGenerated: true if lead came from SAM/automated import
  systemGenerated      Boolean             @default(false)
  /// Status of the lead. Stored as an enum rather than string for consistency.
  status               LeadStatus          @default(NEW)
  disputeStatus        DisputeStatus?      @default(NONE)
  disputeReason        String?
  disputeResolvedAt    DateTime?
  disputeResolvedBy    String?
  classificationType   ClassificationType?
  classificationReason String?
  classifiedAt         DateTime?
  classifiedBy         String?
  qualityScore         Int?
  qualityNotes         String?
  qualityScoredAt      DateTime?
  qualityScoredBy      String?
  org                  Org                 @relation(fields: [orgId], references: [id])
  LeadInvoiceLine      LeadInvoiceLine[]

  @@index([orgId, createdAt])
  @@index([orgId, convertedAt])
  @@index([orgId, status])
  @@index([orgId, sourceType])
  @@index([orgId, identityHash])
  @@index([orgId, disputeStatus])
}

model Customer {
  id            String        @id @default(cuid())
  orgId         String
  publicId      String        @unique
  company       String?
  primaryName   String?
  primaryEmail  String?
  primaryPhone  String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  org           Org           @relation(fields: [orgId], references: [id])
  invoices      Invoice[]
  jobs          Job[]
  opportunities Opportunity[]
}

model Opportunity {
  id             String    @id @default(cuid())
  orgId          String
  customerId     String
  valueType      ValueType @default(RELATIONSHIP)
  estValue       Decimal?  @db.Decimal(12, 2)
  stage          String    @default("new")
  ownerId        String?
  sourceLeadId   String?
  classification Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer       Customer  @relation(fields: [customerId], references: [id])
  org            Org       @relation(fields: [orgId], references: [id])
}

model Invoice {
  id         String        @id @default(cuid())
  orgId      String
  customerId String?
  amount     Decimal       @db.Decimal(12, 2)
  status     String        @default("draft")
  issuedAt   DateTime      @default(now())
  items      Json          @default("[]")
  customer   Customer?     @relation(fields: [customerId], references: [id])
  org        Org           @relation(fields: [orgId], references: [id])
  lineItems  InvoiceLine[]
  payments   Payment[]
}

model Payment {
  id                    String    @id @default(cuid())
  orgId                 String
  invoiceId             String?
  amount                Decimal   @db.Decimal(12, 2)
  method                String    @default("stripe")
  receivedAt            DateTime  @default(now())
  reference             String?
  failureReason         String?
  lastRetryAt           DateTime?
  retryCount            Int       @default(0)
  status                String    @default("succeeded")
  stripeChargeId        String?
  stripePaymentIntentId String?
  invoice               Invoice?  @relation(fields: [invoiceId], references: [id])
  org                   Org       @relation(fields: [orgId], references: [id])

  @@index([orgId, status])
  @@index([stripePaymentIntentId])
  @@index([stripeChargeId])
}

model Rfp {
  id          String    @id @default(cuid())
  orgId       String
  publicId    String    @unique
  sourceSite  String
  title       String
  dueDate     DateTime?
  docs        Json      @default("[]")
  aiBidFit    Int?
  aiPriceHint Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  jobs        Job[]
  org         Org       @relation(fields: [orgId], references: [id])
}

model Job {
  id         String    @id @default(cuid())
  orgId      String
  customerId String?
  rfpId      String?
  status     String    @default("planned")
  schedule   Json      @default("{}")
  assignedTo String?
  checklist  Json      @default("[]")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer? @relation(fields: [customerId], references: [id])
  org        Org       @relation(fields: [orgId], references: [id])
  rfp        Rfp?      @relation(fields: [rfpId], references: [id])
}

model Referral {
  id            String    @id @default(cuid())
  orgId         String
  employeeId    String?
  referredName  String
  referredEmail String?
  referredPhone String?
  status        String    @default("new")
  convertedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  org           Org       @relation(fields: [orgId], references: [id])
}

model BillingLedger {
  id        String     @id @default(cuid())
  orgId     String
  type      LedgerType
  amount    Decimal    @db.Decimal(12, 2)
  meta      Json       @default("{}")
  createdAt DateTime   @default(now())
  org       Org        @relation(fields: [orgId], references: [id])

  @@index([orgId, type])
}

/// LeadInvoice represents a monthly invoice for converted leads. This is separate from the
/// existing Invoice model used for customers/jobs. It aggregates lead conversions and
/// includes metadata to support billing and optional Stripe integration.
model LeadInvoice {
  id              String            @id @default(cuid())
  orgId           String?
  number          String            @unique
  periodFrom      DateTime
  periodTo        DateTime
  status          String
  subtotalCents   Int
  taxCents        Int               @default(0)
  totalCents      Int
  currency        String            @default("usd")
  stripeInvoiceId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  /// Number of leads billed on this invoice (to support flat-per-lead billing)
  leadCount       Int               @default(0)
  org             Org?              @relation("OrgLeadInvoices", fields: [orgId], references: [id])
  lines           LeadInvoiceLine[]
}

/// LeadInvoiceLine represents an individual line item on a LeadInvoice. Each line is typically
/// associated with a converted lead, but generic fee/credit lines are also supported.
model LeadInvoiceLine {
  id             String      @id @default(cuid())
  invoiceId      String
  leadId         String?
  description    String
  quantity       Int         @default(1)
  unitPriceCents Int
  amountCents    Int
  source         String?
  createdAt      DateTime    @default(now())
  invoice        LeadInvoice @relation(fields: [invoiceId], references: [id])
  lead           Lead?       @relation(fields: [leadId], references: [id])

  @@index([invoiceId])
  @@index([leadId])
}

model AuditLog {
  id          String   @id @default(cuid())
  orgId       String
  /// Identifier of the record affected
  entityId    String?
  createdAt   DateTime @default(now())
  actorUserId String?
  /// The entity type affected (e.g. 'lead', 'invoice', 'pricing', etc.)
  entity      String
  /// Name of the field that was changed (nullable for record-level actions)
  field       String?
  /// New value (JSON) after the change, if applicable
  newValue    Json?
  /// Previous value (JSON) before the change, if applicable
  oldValue    Json?
  /// Free-form reason or comment describing why the change was made
  reason      String?
  org         Org      @relation(fields: [orgId], references: [id])
}

model RbacPermission {
  id          String               @id @default(cuid())
  code        String               @unique
  description String?
  createdAt   DateTime             @default(now())
  rolePerms   RbacRolePermission[]
}

model RbacRole {
  id        String               @id @default(cuid())
  orgId     String?
  name      String
  slug      String
  isSystem  Boolean              @default(false)
  createdAt DateTime             @default(now())
  org       Org?                 @relation("OrgRbacRoles", fields: [orgId], references: [id])
  rolePerms RbacRolePermission[]
  userRoles RbacUserRole[]

  @@unique([orgId, slug])
}

model RbacRolePermission {
  roleId       String
  permissionId String
  permission   RbacPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         RbacRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RbacUserRole {
  id     String   @id @default(cuid())
  userId String
  orgId  String?
  roleId String
  org    Org?     @relation("OrgRbacUserRoles", fields: [orgId], references: [id])
  role   RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User     @relation("UserRbacUserRoles", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, orgId])
}

/// ProviderConfig holds provider-level secrets and configuration separate from any organization.
/// These values are used for system integrations that the provider controls, such as SAM.gov or
/// Stripe secrets used when billing clients.  Only one row is typically used.  Use a simple
/// admin interface to update these values.
model ProviderConfig {
  id                   String   @id @default(cuid())
  samApiKey            String?
  stripeSecretKey      String?
  otherConfig          Json?    @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  contactEmail         String?
  featureFlags         Json?    @default("{\"analytics-v2\": true, \"multi-region\": false, \"action-center\": true, \"api-key-management\": true, \"advanced-monitoring\": false}")
  integrationSettings  Json?    @default("{\"apiRateLimit\": 1000, \"samGovConfigured\": false, \"stripeConfigured\": false}")
  notificationSettings Json?    @default("{\"emailAlerts\": true, \"weeklyReports\": true, \"monthlyReports\": true, \"slackNotifications\": false}")
  providerName         String?
  securitySettings     Json?    @default("{\"ipWhitelist\": [], \"twoFactorEnabled\": false, \"sessionTimeoutMinutes\": 30}")
  supportUrl           String?
  themeSettings        Json     @default("{\"variant\": \"premium-dark\", \"accentColor\": \"#3aa8ff\", \"primaryColor\": \"#00ff88\"}")
}

/// PricingPlan defines how an organization is billed for leads. Each org can have only
/// one pricing plan record. A plan specifies the billing model (e.g. per-lead fixed fee)
/// and can include tiered structures or prepaid units via includedUnits and tiersJson.
model PricingPlan {
  orgId         String       @id
  /// Billing model used for this organization (per-lead, tiered, subscription, or hybrid)
  model         PricingModel @default(PER_LEAD_FIXED)
  /// ISO currency code (e.g. "usd")
  currency      String       @default("usd")
  /// Fixed unit price in cents for per-lead billing
  unitAmount    Int          @default(10000)
  /// JSON-encoded pricing tiers (used when model is TIERED or HYBRID)
  tiersJson     Json?
  /// Number of prepaid leads included before billing starts
  includedUnits Int          @default(0)
  org           Org          @relation("OrgPricingPlan", fields: [orgId], references: [id])
}

model AiUsageEvent {
  id          String   @id @default(cuid())
  orgId       String
  userId      String?
  feature     String
  model       String
  tokensIn    Int
  tokensOut   Int
  costUsd     Decimal  @db.Decimal(8, 6)
  creditsUsed Int
  requestId   String?
  createdAt   DateTime @default(now())
  org         Org      @relation("OrgAiUsageEvents", fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, feature])
}

model AiMonthlySummary {
  id          String   @id @default(cuid())
  orgId       String
  monthKey    String
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  costUsd     Decimal  @default(0) @db.Decimal(8, 2)
  creditsUsed Int      @default(0)
  callCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  org         Org      @relation("OrgAiMonthlySummaries", fields: [orgId], references: [id])

  @@unique([orgId, monthKey])
  @@index([monthKey])
}

/// Activity tracks cross-entity timeline events for provider operations
/// Used for unified activity feeds across leads, invoices, incidents, etc.
model Activity {
  id         String   @id @default(cuid())
  orgId      String
  actorType  String
  actorId    String?
  entityType String
  entityId   String
  action     String
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())
  org        Org      @relation("OrgActivities", fields: [orgId], references: [id])

  @@index([orgId, entityType, entityId, createdAt])
  @@index([orgId, createdAt])
}

/// Subscription tracks plan lifecycle for provider billing operations
/// Supports MRR/ARR calculations, churn analysis, and plan changes
model Subscription {
  id         String    @id @default(cuid())
  orgId      String
  plan       String
  status     String
  startedAt  DateTime
  canceledAt DateTime?
  renewsAt   DateTime?
  priceCents Int
  meta       Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  org        Org       @relation("OrgSubscriptions", fields: [orgId], references: [id])

  @@index([orgId, status])
  @@index([status, renewsAt])
}

/// UsageMeter records raw usage units before rating/billing
/// Used for usage-based billing and cost tracking
model UsageMeter {
  id          String   @id @default(cuid())
  orgId       String
  meter       String
  quantity    Int
  windowStart DateTime
  windowEnd   DateTime
  createdAt   DateTime @default(now())
  org         Org      @relation("OrgUsageMeters", fields: [orgId], references: [id])

  @@index([orgId, meter, windowStart])
  @@index([windowStart, windowEnd])
}

/// AddonPurchase tracks one-off purchases and refunds
/// Used for add-on revenue tracking and reconciliation
model AddonPurchase {
  id          String    @id @default(cuid())
  orgId       String
  sku         String
  amount      Decimal   @db.Decimal(12, 2)
  status      String
  purchasedAt DateTime  @default(now())
  refundedAt  DateTime?
  meta        Json      @default("{}")
  org         Org       @relation("OrgAddonPurchases", fields: [orgId], references: [id])

  @@index([orgId, sku, status])
  @@index([purchasedAt])
}

/// FederationKey stores HMAC keys for provider-side federation
/// Used for secure machine-to-machine authentication
model FederationKey {
  id         String    @id @default(cuid())
  keyId      String    @unique
  secretHash String
  createdAt  DateTime  @default(now())
  disabledAt DateTime?
  orgId      String

  @@index([orgId, keyId])
}

/// OIDCConfig stores OIDC/OAuth provider configuration for federation
model OIDCConfig {
  id           String    @id @default(cuid())
  enabled      Boolean   @default(false)
  issuerUrl    String
  clientId     String
  clientSecret String
  scopes       String    @default("openid profile email")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastTestedAt DateTime?
}

/// ProviderIntegration tracks external provider connections
model ProviderIntegration {
  id         String    @id @default(cuid())
  name       String
  type       String
  config     Json      @default("{}")
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSyncAt DateTime?

  @@index([type, enabled])
}

/// AuditEvent stores provider-side audit trail
model AuditEvent {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  orgId      String?
  redactJson Json?
  result     String   @default("success")

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([orgId, entityType, createdAt])
}

/// AnalyticsSnapshot stores daily aggregated metrics for caching
model AnalyticsSnapshot {
  id             String   @id @default(cuid())
  snapshotDate   DateTime @unique @db.Date
  mrrCents       Int      @default(0)
  arrCents       Int      @default(0)
  activeClients  Int      @default(0)
  newClients     Int      @default(0)
  churnedClients Int      @default(0)
  totalRevenue   Int      @default(0)
  metricsJson    Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([snapshotDate])
}

/// Incident lifecycle tracking with SLA fields
model Incident {
  id                  String           @id @default(cuid())
  orgId               String
  severity            IncidentSeverity
  status              IncidentStatus   @default(OPEN)
  title               String
  description         String
  assigneeUserId      String?
  slaResponseDeadline DateTime?
  slaResolveDeadline  DateTime?
  acknowledgedAt      DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  org                 Org              @relation("OrgIncidents", fields: [orgId], references: [id])

  @@index([orgId, status, createdAt])
  @@index([orgId, severity])
}

/// InvoiceLine ties granular charges to Invoices
model InvoiceLine {
  id             String          @id @default(cuid())
  invoiceId      String
  description    String
  lineType       InvoiceLineType
  quantity       Int             @default(1)
  unitPriceCents Int
  amountCents    Int
  sourceType     String?
  sourceId       String?
  createdAt      DateTime        @default(now())
  invoice        Invoice         @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([sourceType, sourceId])
}

/// Provider in-app notifications
model Notification {
  id        String    @id @default(cuid())
  orgId     String?
  audience  String
  type      String
  title     String
  body      String
  severity  String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  org       Org?      @relation("OrgNotifications", fields: [orgId], references: [id])

  @@index([orgId, createdAt])
