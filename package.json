{
  "name": "cortiware",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "phase:0": "tsx scripts/operating/phase0_schema_audit.ts",
    "ci:slices:sync": "tsx scripts/ci/sync_slice_issues.ts",
    "setpwd": "tsx scripts/set-password.ts",
    "setup-accounts": "tsx scripts/setup-accounts.ts",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "vercel-build": "node scripts/run-migrations-if-configured.js && npm run prisma:generate && turbo run build",
    "vercel-build:provider": "npm run prisma:generate && cd apps/provider-portal && npm run build",
    "vercel-build:tenant": "npm run prisma:generate && cd apps/tenant-app && npm run build",
    "clean": "turbo run clean && rm -rf node_modules/.cache",
    "seed": "tsx prisma/seed.ts",
    "seed:provider": "cd apps/provider-portal && npm run prisma:seed",
    "db:seed:preview": "tsx prisma/seed-preview.ts",
    "prisma:generate": "npx prisma generate --schema=prisma/schema.prisma && cd apps/provider-portal && npx prisma generate",
    "prisma:studio:tenant": "npx prisma studio --schema=prisma/schema.prisma",
    "prisma:studio:provider": "cd apps/provider-portal && npx prisma studio",
    "prisma:migrate:tenant": "npx prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:provider": "cd apps/provider-portal && npx prisma migrate dev",
    "prisma:regen": "powershell -ExecutionPolicy Bypass -File ./scripts/regenerate-prisma.ps1",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:vitest": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:unit": "tsx tests/unit/run.ts",
    "test:e2e": "tsx tests/e2e/run.ts",
    "test:e2e:playwright": "playwright test",
    "test:e2e:playwright:ui": "playwright test --ui",
    "test:e2e:playwright:headed": "playwright test --headed",
    "test:e2e:playwright:debug": "playwright test --debug",
    "test:e2e:playwright:report": "playwright show-report",
    "test:e2e:tenant": "playwright test tests/e2e-playwright/tenant-app",
    "test:e2e:provider": "playwright test tests/e2e-playwright/provider-portal",
    "test:e2e:vercel": "powershell -ExecutionPolicy Bypass -File ./scripts/run-e2e-vercel.ps1",
    "test:e2e:all": "npm run test:unit && npm run test:e2e && npm run test:e2e:playwright",
    "contracts:gen": "node scripts/generate-contract-snapshot.js",
    "contracts:diff": "node scripts/diff-contracts.js --fail-on-breaking",
    "contracts:check": "npm run contracts:gen && node scripts/diff-contracts.js --fail-on-breaking",
    "contracts:promote": "node scripts/promote-contracts.js",
    "perf:baseline": "node scripts/performance/measure-baseline.js",
    "perf:measure": "node scripts/performance/measure-baseline.js && mv scripts/performance/baseline.json scripts/performance/current.json",
    "perf:compare": "node scripts/performance/compare-results.js",
    "trace:update": "tsx scripts/trace/update-trace-matrix.ts",
    "ci:placeholders": "tsx scripts/ci/verify_no_placeholders.ts",
    "ci:placeholders:sync": "tsx scripts/ci/sync_placeholder_issues.ts",
    "prepare": "node -e \"try{require('husky').install()}catch(e){process.exit(0)}\"",
    "mcp:dryrun": "tsx scripts/mcp-launcher.ts --dry",
    "mcp:launch": "tsx scripts/mcp-launcher.ts",
    "mcp:stop": "tsx scripts/mcp-stop.ts",
    "dev:with-mcp": "npx tsx scripts/mcp-launcher.ts --detach --servers=github-robinsonai,vercel-robinsonai,neon-robinsonai && npm run dev"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@sendgrid/mail": "8.1.0",
    "@stripe/react-stripe-js": "^4.0.2",
    "@stripe/stripe-js": "^7.9.0",
    "@tremor/react": "^3.18.7",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "daisyui": "^5.1.27",
    "flowbite": "^3.1.2",
    "flowbite-react": "^0.12.9",
    "ioredis": "^5.8.1",
    "lucide-react": "^0.545.0",
    "next": "^15.1.0",
    "openai": "^5.23.0",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.2",
    "preline": "^3.2.3",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.2.1",
    "stripe": "^14.25.0",
    "swr": "^2.2.5",
    "tailwind-merge": "^3.3.1",
    "twilio": "4.22.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@next/bundle-analyzer": "^15.5.5",
    "@playwright/test": "^1.56.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "18.2.22",
    "@types/stripe": "^8.0.416",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/coverage-v8": "^4.0.4",
    "@vitest/ui": "^4.0.4",
    "autoprefixer": "10.4.20",
    "detect-secrets": "^1.0.6",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "playwright": "^1.56.0",
    "postcss": "8.4.47",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "tailwindcss": "3.4.10",
    "tsx": "^4.20.5",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "vitest": "^4.0.4",
    "zod": "^3.25.76"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  }
}
